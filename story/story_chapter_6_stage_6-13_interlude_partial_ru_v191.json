  "dialogues": [
    {
      "ordinal": 1,
      "source_line": 6,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Очнись!!!"
    },
    {
      "ordinal": 2,
      "source_line": 7,
      "kind": "unnamed",
      "text_ru": "……?"
    },
    {
      "ordinal": 3,
      "source_line": 8,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Очнись… Очнись!"
    },
    {
      "ordinal": 4,
      "source_line": 9,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Адам! Сюда! Неси тёплую воду!"
    },
    {
      "ordinal": 5,
      "source_line": 10,
      "kind": "unnamed",
      "text_ru": "Папа…"
    },
    {
      "ordinal": 6,
      "source_line": 11,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "А…"
    },
    {
      "ordinal": 7,
      "source_line": 12,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Она жива! Слава предкам, она жива! Она жива!"
    },
    {
      "ordinal": 8,
      "source_line": 13,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Адам! Поторопись!"
    },
    {
      "ordinal": 9,
      "source_line": 14,
      "kind": "unnamed",
      "text_ru": "Па… папа…?"
    },
    {
      "ordinal": 10,
      "source_line": 15,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Папа?"
    },
    {
      "ordinal": 11,
      "source_line": 16,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Я… да! Я папа!"
    },
    {
      "ordinal": 12,
      "source_line": 17,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Да, да! Я папа, всё верно!"
    },
    {
      "ordinal": 13,
      "source_line": 18,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Не засыпай, не засыпай! Держи папу за руку и не отпускай!"
    },
    {
      "ordinal": 14,
      "source_line": 19,
      "kind": "unnamed",
      "text_ru": "Папа… Мне так… холодно…"
    },
    {
      "ordinal": 15,
      "source_line": 20,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Не засыпай, доченька, моя девочка! Живи!"
    },
    {
      "ordinal": 16,
      "source_line": 21,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Её температура продолжает падать! Мишка, придумай что-нибудь!"
    },
    {
      "ordinal": 17,
      "source_line": 22,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Неужели нельзя перенаправить поток?"
    },
    {
      "ordinal": 18,
      "source_line": 23,
      "kind": "unnamed",
      "text_ru": "Холодно…! Папа! Мне холодно!"
    },
    {
      "ordinal": 19,
      "source_line": 24,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "…Доченька… моя доченька! Держись!"
    },
    {
      "ordinal": 20,
      "source_line": 25,
      "kind": "unnamed",
      "text_ru": "Папа, не надо… Не оставляй меня больше…"
    },
    {
      "ordinal": 21,
      "source_line": 31,
      "kind": "unnamed",
      "text_ru": "10:48 утра"
    },
    {
      "ordinal": 22,
      "source_line": 32,
      "kind": "unnamed",
      "text_ru": "Руины района «14» города-спутника Чернобога"
    },
    {
      "ordinal": 23,
      "source_line": 33,
      "kind": "unnamed",
      "text_ru": "Верхний ярус фундамента"
    },
    {
      "ordinal": 24,
      "source_line": 34,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "……"
    },
    {
      "ordinal": 25,
      "source_line": 41,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Я уже проснулась."
    },
    {
      "ordinal": 26,
      "source_line": 42,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Ты не убил меня, пока я была без сознания. Из-за уверенности в себе или по какой-то другой причине?"
    },
    {
      "ordinal": 27,
      "source_line": 52,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Как бы то ни было, ты этого не сделал."
    },
    {
      "ordinal": 28,
      "source_line": 58,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "……"
    },
    {
      "ordinal": 29,
      "source_line": 59,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Считай, что ты уже пощадил меня. Теперь я отплачу тем же и не стану тебя убивать."
    },
    {
      "ordinal": 30,
      "source_line": 62,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Что это за сложное выражение у тебя на лице?"
    },
    {
      "ordinal": 31,
      "source_line": 63,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Это потому, что… я рассказала всё, что видела во сне?"
    },
    {
      "ordinal": 32,
      "source_line": 66,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Похоже, пока я была без сознания, я и правда выболтала кое-что весьма неприятное."
    },
    {
      "ordinal": 33,
      "source_line": 67,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Воспоминания, оказывается, не так-то просто выбросить из головы, даже если хочется."
    },
    {
      "ordinal": 34,
      "source_line": 69,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Ты осмотрел окрестности?"
    },
    {
      "ordinal": 35,
      "source_line": 70,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Выхода не нашёл, верно?"
    },
    {
      "ordinal": 36,
      "source_line": 71,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Похоже, какое-то время нам отсюда не выбраться."
    },
    {
      "ordinal": 37,
      "source_line": 73,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "……"
    },
    {
      "ordinal": 38,
      "source_line": 76,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Того, кого я называю отцом, зовут Бульдроккасти. Когда-то он был офицером армии Урсуса."
    },
    {
      "ordinal": 39,
      "source_line": 77,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Но мой родной отец умер очень давно."
    },
    {
      "ordinal": 40,
      "source_line": 78,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "В детстве я смутно помню, как один мужчина заслонил собой женщину от арбалетных болтов. А женщина прижала меня к груди и своей спиной остановила вторую очередь болтов."
    },
    {
      "ordinal": 41,
      "source_line": 82,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Тогда я была слишком мала, чтобы понять, что происходит. Просто это воспоминание случайно не стёрлось."
    },
    {
      "ordinal": 42,
      "source_line": 83,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "А что произошло на самом деле, мне позже рассказала бабушка."
    },
    {
      "ordinal": 43,
      "source_line": 84,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Когда я стала расспрашивать бабушку, что означает то воспоминание, и ей уже не удалось отмахнуться, она всё мне рассказала."
    },
    {
      "ordinal": 44,
      "source_line": 85,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "«Это были твои родные родители… Они защитили тебя перед смертью»."
    },
    {
      "ordinal": 45,
      "source_line": 86,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Ирония в том, что я совсем их не знала. Кроме этой картины, в памяти не осталось ничего, что было бы с ними связано."
    },
    {
      "ordinal": 46,
      "source_line": 87,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Так я и забыла своих родных родителей. Мне даже трудно сказать, что я что-то к ним чувствую."
    },
    {
      "ordinal": 47,
      "source_line": 88,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "……"
    },
    {
      "ordinal": 48,
      "source_line": 91,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Поровну. Другую половину составила кровь заражённых Урсуса."
    },
    {
      "ordinal": 49,
      "source_line": 94,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Хе…"
    },
    {
      "ordinal": 50,
      "source_line": 100,
      "kind": "named",
      "speaker_cn": "霜星",
      "text_ru": "Я родилась на одном из рудников северо-западной тундры."
    },
    {
      "ordinal": 51,
      "source_line": 101,
      "kind": "named",
      "text_ru": "Рудник был небольшим и находился в глуши, далеко от городов; поблизости не было ни одного поселения. Куда ни глянь, круглый год — один снег.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 52,
      "source_line": 102,
      "kind": "named",
      "text_ru": "Этот рудник был настоящим адом, созданным лишь для того, чтобы нести смерть и рабство. На снежных равнинах таких рудников бесчисленное множество.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 53,
      "source_line": 103,
      "kind": "named",
      "text_ru": "Мои родные родители работали шахтёрами в этом аду.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 54,
      "source_line": 104,
      "kind": "named",
      "text_ru": "Бабушка была со мной, пока я училась говорить, но так и не рассказала, за какие преступления родителей приговорили к каторжным работам в руднике.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 55,
      "source_line": 105,
      "kind": "named",
      "text_ru": "Позже, когда я подросла, я расспрашивала людей в руднике и узнала, что оба моих родителя выступали против военных планов императора Урсуса.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 56,
      "source_line": 106,
      "kind": "named",
      "text_ru": "Их арестовали по ошибке. Две последние строки в ордере на арест были пустыми, и сержант, руководивший обыском, наугад переписал имя с таблички на двери.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 57,
      "source_line": 107,
      "kind": "named",
      "text_ru": "Без суда и следствия родителей лишили имён и отправили из тёплого маленького городка в холодные северные земли отбывать каторгу сроком в несколько столетий.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 58,
      "source_line": 108,
      "kind": "named",
      "text_ru": "Разумеется, никто не дожил бы до конца такого срока, не говоря уже о том, чтобы выйти оттуда живым.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 59,
      "source_line": 109,
      "kind": "named",
      "text_ru": "Бабушку как «укрывательницу преступников» тоже приговорили к каторжным работам и отправили вместе с ними.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 60,
      "source_line": 110,
      "kind": "named",
      "text_ru": "На самом деле почти все шахтёры в том руднике прошли через нечто подобное.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 61,
      "source_line": 111,
      "kind": "named",
      "text_ru": "Как и следовало ожидать, мои родители заразились орипатией во время работы в шахте. Как и все шахтёры.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 62,
      "source_line": 112,
      "kind": "named",
      "text_ru": "Даже если бы ты сбежал из этого рудника, никто бы не поверил ни единому твоему слову. Ты всего лишь заражённый — самый страшный, злобный и неуравновешенный из больных орипатией.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 63,
      "source_line": 113,
      "kind": "named",
      "text_ru": "Однако надзиратели рудника — один из гарнизонов армии Урсуса — считали, что заражённые и так умирают слишком медленно.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 64,
      "source_line": 114,
      "kind": "named",
      "text_ru": "Они тянули жребий, решая судьбу больных орипатией, и убивали их ради забавы.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 65,
      "source_line": 115,
      "kind": "named",
      "text_ru": "Возможно, не снег свёл шахтёров с ума, а сами шахтёры — их. А может, в их глазах заражённые и вовсе не считались людьми.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 66,
      "source_line": 116,
      "kind": "named",
      "text_ru": "Когда мне было пять, моим родителям выпал чёрный жребий.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 67,
      "source_line": 117,
      "kind": "named",
      "text_ru": "Когда мне было десять, чёрный жребий выпал бабушке.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 68,
      "source_line": 118,
      "kind": "named",
      "text_ru": "В одиннадцать чёрный жребий выпал уже мне, но это было неважно: к тому времени им стало всё равно, кто вытянет жребий. Они просто хотели закрыть весь рудник.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 69,
      "source_line": 119,
      "kind": "named",
      "text_ru": "К тому времени все взрослые заражённые в руднике уже умерли, а новая политика императора привела к тому, что рабочей силы там почти не осталось.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 70,
      "source_line": 120,
      "kind": "named",
      "text_ru": "По приказу урсусские надзиратели собирались казнить последних заражённых… нескольких больных детей.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 71,
      "source_line": 121,
      "kind": "named",
      "text_ru": "После этого они собирались взорвать рудник, превратив его в братскую могилу заражённых, чтобы скрыть собственные преступления.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 72,
      "source_line": 122,
      "kind": "named",
      "text_ru": "Позже, во время своих странствий, я узнала, что они постоянно так поступают.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 73,
      "source_line": 123,
      "kind": "named",
      "text_ru": "Мне было горько. Мне было больно.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 74,
      "source_line": 124,
      "kind": "named",
      "text_ru": "Я разбила немало руды. Я жила в руднике с другими детьми, мы были друг другу как братья и сёстры — и теперь все мы должны были бессмысленно погибнуть.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 75,
      "source_line": 125,
      "kind": "named",
      "text_ru": "В груди зарождались всё более сильные чувства; перед глазами стояли смерти моих родителей и бабушки.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 76,
      "source_line": 126,
      "kind": "named",
      "text_ru": "Когда началась казнь, моя магия вырвалась наружу и на месте убила четырёх солдат, исполнявших приговор.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 77,
      "source_line": 127,
      "kind": "named",
      "text_ru": "Разумеется, изменить ход событий я не могла.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 78,
      "source_line": 128,
      "kind": "named",
      "text_ru": "Для надзирателей дети были просто скотом. Они, солдаты, держали в руках острые клинки и носили прочную броню, а мы были словно букашки, сумевшие лишь ужалить их.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 79,
      "source_line": 129,
      "kind": "named",
      "text_ru": "Когда они повалили меня на землю и готовились начать последнюю волну расправы, до меня донеслись крики моих братьев и сестёр…",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 80,
      "source_line": 130,
      "kind": "named",
      "text_ru": "И тут появился партизанский отряд.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 81,
      "source_line": 137,
      "kind": "named",
      "text_ru": "Это был отряд Бульдроккасти.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 82,
      "source_line": 138,
      "kind": "named",
      "text_ru": "Все урсусские солдаты, охраняющие заражённых на северо-западной тундре, видят сны. И этот отряд — их самый страшный кошмар.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 83,
      "source_line": 142,
      "kind": "named",
      "text_ru": "Если бы могла, я бы гордилась ими.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 84,
      "source_line": 143,
      "kind": "named",
      "text_ru": "Они перебили всех палачей прямо у нас на глазах, и дети-заражённые из рудника спаслись.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 85,
      "source_line": 144,
      "kind": "named",
      "text_ru": "Но…",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 86,
      "source_line": 145,
      "kind": "named",
      "text_ru": "На этой безжалостно белой земле кровь моих менее удачливых товарищей смешалась с кровью убитых солдат и застыла льдом.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 87,
      "source_line": 146,
      "kind": "named",
      "text_ru": "И в тот миг я вдруг кое-что поняла…",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 88,
      "source_line": 147,
      "kind": "named",
      "text_ru": "Эти урсусские солдаты изначально лишь исполняли приказы. У них была такая же кровь, как у нас.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 89,
      "source_line": 148,
      "kind": "named",
      "text_ru": "Поток пропаганды, приукрашенные истории и намеренно раздутая вражда пустили в них корни жестокости и равнодушия.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 90,
      "source_line": 149,
      "kind": "named",
      "text_ru": "Именно Урсус превратил их в таких.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 91,
      "source_line": 161,
      "kind": "named",
      "text_ru": "С-с… м-м…",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 92,
      "source_line": 162,
      "kind": "named",
      "text_ru": "Прошу… помоги мне.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 93,
      "source_line": 163,
      "kind": "named",
      "text_ru": "В левом кармане моей куртки лежит несколько конфет. Возьми одну.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 94,
      "source_line": 164,
      "kind": "named",
      "text_ru": "…Если хочешь попробовать, можешь взять и одну себе.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 95,
      "source_line": 171,
      "kind": "named",
      "text_ru": "Боишься, что конфета отравлена?",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 96,
      "source_line": 172,
      "kind": "named",
      "text_ru": "Может, ты и не любишь сладкое, но попробуй. В Лунмэне такую конфету не достать.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 97,
      "source_line": 173,
      "kind": "named",
      "text_ru": "Это особые конфеты из Урсуса. Съешь одну — и одной такой конфетой в мире станет меньше.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 98,
      "source_line": 174,
      "kind": "named",
      "text_ru": "В благодарность за то, что достал мне конфету, попробуй и сам.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 99,
      "source_line": 177,
      "kind": "named",
      "text_ru": "О? Похоже, ты всё-таки любишь сладости.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 100,
      "source_line": 178,
      "kind": "named",
      "text_ru": "Только предупреждаю: эта конфета может совсем не походить по вкусу на всё, что ты пробовал раньше.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 101,
      "source_line": 179,
      "kind": "named",
      "text_ru": "Но жизнь коротка. Стоит попробовать что-нибудь новое, верно?",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 102,
      "source_line": 183,
      "kind": "named",
      "text_ru": "Пожалуйста, положи конфету мне в рот. Осторожно, не касайся моей кожи.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 103,
      "source_line": 186,
      "kind": "named",
      "text_ru": "От кончиков пальцев до шеи всё моё тело парализовано. Я могу двигать только тем, что выше шеи.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 104,
      "source_line": 187,
      "kind": "named",
      "text_ru": "Но даже едва шевельнув языком, я всё ещё могу мгновенно заморозить тебя насмерть.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 105,
      "source_line": 188,
      "kind": "named",
      "text_ru": "Так что не беспокойся. Если ты всё-таки меня оскорбишь, скоро умрёшь.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 106,
      "source_line": 191,
      "kind": "named",
      "text_ru": "Спасибо.",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 107,
      "source_line": 194,
      "kind": "unnamed",
      "text_ru": "Конфета очень острая."
    },
    {
      "ordinal": 108,
      "source_line": 196,
      "kind": "unnamed",
      "text_ru": "Конфета невероятно острая."
    },
    {
      "ordinal": 109,
      "source_line": 198,
      "kind": "unnamed",
      "text_ru": "Конфета невыносимо жгучая."
    },
    {
      "ordinal": 110,
      "source_line": 200,
      "kind": "named",
      "text_ru": "……",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 111,
      "source_line": 204,
      "kind": "named",
      "text_ru": "У тебя такое лицо…",
      "speaker_cn": "霜星"
    },
    {
      "ordinal": 112,
      "source_line": 205,
      "kind": "named",
      "text_ru": "Хе-хе…",
      "speaker_cn": "霜星"
    }
  ],
