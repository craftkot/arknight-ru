  "dialogues": [
    {
      "ordinal": 1,
      "source_line": 6,
      "speaker_ru": "Блейз",
      "text_ru": "Ха… ха…"
    },
    {
      "ordinal": 2,
      "source_line": 8,
      "speaker_ru": "Амия",
      "text_ru": "Блейз!"
    },
    {
      "ordinal": 3,
      "source_line": 10,
      "speaker_ru": "Блейз",
      "text_ru": "Я в порядке! А они… действительно кое-что умеют."
    },
    {
      "ordinal": 4,
      "source_line": 11,
      "speaker_ru": "Блейз",
      "text_ru": "Вы там не замёрзли?"
    },
    {
      "ordinal": 5,
      "source_line": 13,
      "speaker_ru": "Амия",
      "text_ru": "Только ты могла нагреть воздух вокруг нас настолько, чтобы остановить её ледяной поток. Благодаря тебе мы почти не пострадали."
    },
    {
      "ordinal": 6,
      "source_line": 15,
      "speaker_ru": "Блейз",
      "text_ru": "Пустяки."
    },
    {
      "ordinal": 7,
      "source_line": 17,
      "speaker_ru": "Блейз",
      "text_ru": "Эй, ледяная, почему ты не применяешь смертельные Искусства?"
    },
    {
      "ordinal": 8,
      "source_line": 20,
      "speaker_ru": "ФростНова",
      "text_ru": "Кхе, кхе…"
    },
    {
      "ordinal": 9,
      "source_line": 22,
      "speaker_ru": "Блейз",
      "text_ru": "…"
    },
    {
      "ordinal": 10,
      "source_line": 23,
      "speaker_ru": "Блейз",
      "text_ru": "Теперь понятно."
    },
    {
      "ordinal": 11,
      "source_line": 25,
      "speaker_ru": "Амия",
      "text_ru": "…ФростНова… в каком же она состоянии…"
    },
    {
      "ordinal": 12,
      "source_line": 27,
      "speaker_ru": "Блейз",
      "text_ru": "Так её зовут ФростНова?"
    },
    {
      "ordinal": 13,
      "source_line": 29,
      "speaker_ru": "ФростНова",
      "text_ru": "Кхе… прикройте… меня…"
    },
    {
      "ordinal": 14,
      "source_line": 31,
      "speaker_ru": "Боец отряда снежных чудовищ",
      "text_ru": "Сестра…"
    },
    {
      "ordinal": 15,
      "source_line": 33,
      "speaker_ru": "Блейз",
      "text_ru": "Уходим, Амия. По дороге могут встретиться другие бойцы Воссоединения. Есть раненые? Я помогу."
    },
    {
      "ordinal": 16,
      "source_line": 35,
      "speaker_ru": "ФростНова",
      "text_ru": "Думаете, так просто отступить?"
    },
    {
      "ordinal": 17,
      "source_line": 37,
      "speaker_ru": "Блейз",
      "text_ru": "Вот тебе совет: прекрати сражаться, белая крольчиха."
    },
    {
      "ordinal": 18,
      "source_line": 38,
      "speaker_ru": "Блейз",
      "text_ru": "Если продолжишь через силу применять Искусства, очень скоро умрёшь. Твоя сила буквально высасывает из тебя жизнь."
    },
    {
      "ordinal": 19,
      "source_line": 39,
      "speaker_ru": "Блейз",
      "text_ru": "Или можешь отправиться на Родос. По крайней мере, мы знаем, как продлить тебе жизнь."
    },
    {
      "ordinal": 20,
      "source_line": 41,
      "speaker_ru": "ФростНова",
      "text_ru": "…"
    },
    {
      "ordinal": 21,
      "source_line": 42,
      "speaker_ru": "ФростНова",
      "text_ru": "…Что за вид, будто ты кого-то жалеешь? Кому нужна ваша жалость?"
    },
    {
      "ordinal": 22,
      "source_line": 44,
      "speaker_ru": "Блейз",
      "text_ru": "Я похожа на человека, который тебя жалеет? Ты сильная, и я тебя уважаю."
    },
    {
      "ordinal": 23,
      "source_line": 46,
      "speaker_ru": "ФростНова",
      "text_ru": "…"
    },
    {
      "ordinal": 24,
      "source_line": 47,
      "speaker_ru": "ФростНова",
      "text_ru": "С какой стати я должна позволять вам уйти?"
    },
    {
      "ordinal": 25,
      "source_line": 49,
      "speaker_ru": "ФростНова",
      "text_ru": "Кхе… кхе-кхе…"
    },
    {
      "ordinal": 26,
      "source_line": 56,
      "speaker_ru": "Блейз",
      "text_ru": "Доктор {@nickname}, скорее уходи! Не смотри на неё!"
    },
    {
      "ordinal": 27,
      "source_line": 58,
      "speaker_ru": "Метеорит",
      "text_ru": "Со стороны внешних руин к нам приближаются бойцы Воссоединения!"
    },
    {
      "ordinal": 28,
      "source_line": 64,
      "speaker_ru": "ФростНова",
      "text_ru": "Не уйдёте."
    },
    {
      "ordinal": 29,
      "source_line": 66,
      "speaker_ru": "Боец отряда снежных чудовищ",
      "text_ru": "Сестра, место, где ты стоишь, слишком опасно! Не применяй это!"
    },
    {
      "ordinal": 30,
      "source_line": 68,
      "speaker_ru": "ФростНова",
      "text_ru": "Нельзя позволить им уйти!"
    },
    {
      "ordinal": 31,
      "source_line": 69,
      "speaker_ru": "ФростНова",
      "text_ru": "Никто не знает, что Родос сделает с нашими товарищами в Лунмэне!"
    },
    {
      "ordinal": 32,
      "source_line": 71,
      "speaker_ru": "ФростНова",
      "text_ru": "Перепад температур растёт… структура… становится хрупкой!"
    },
    {
      "ordinal": 33,
      "source_line": 72,
      "speaker_ru": "ФростНова",
      "text_ru": "Кхе, кхе… Замерзай!"
    },
    {
      "ordinal": 34,
      "source_line": 73,
      "speaker_ru": "ФростНова",
      "text_ru": "…♪…"
    },
    {
      "ordinal": 35,
      "source_line": 74,
      "speaker_ru": "ФростНова",
      "text_ru": "Кхе…!"
    },
    {
      "ordinal": 36,
      "source_line": 80,
      "speaker_ru": "Боец отряда снежных чудовищ",
      "text_ru": "Получается…"
    },
    {
      "ordinal": 37,
      "source_line": 83,
      "speaker_ru": "Боец отряда снежных чудовищ",
      "text_ru": "Заложенный нами оригиний изменил структуру нижних слоёв. Земля уже начала крениться!"
    },
    {
      "ordinal": 38,
      "source_line": 84,
      "speaker_ru": "Боец отряда снежных чудовищ",
      "text_ru": "Сестра, там, где ты стоишь, слишком опасно! Хватайся за меня!"
    },
    {
      "ordinal": 39,
      "source_line": 86,
      "speaker_ru": "ФростНова",
      "text_ru": "…"
    },
    {
      "ordinal": 40,
      "source_line": 88,
      "speaker_ru": "Боец отряда снежных чудовищ",
      "text_ru": "Сестра?!"
    },
    {
      "ordinal": 41,
      "source_line": 94,
      "speaker_ru": "Метеорит",
      "text_ru": "…Блейз, слышишь?"
    },
    {
      "ordinal": 42,
      "source_line": 96,
      "speaker_ru": "Блейз",
      "text_ru": "А?"
    },
    {
      "ordinal": 43,
      "source_line": 98,
      "speaker_ru": "Метеорит",
      "text_ru": "Это треск разрушающихся зданий?"
    },
    {
      "ordinal": 44,
      "source_line": 100,
      "speaker_ru": "Блейз",
      "text_ru": "А-а…"
    },
    {
      "ordinal": 45,
      "source_line": 102,
      "speaker_ru": "Амия",
      "text_ru": "Заложенный оригиний, поглощение тепла, перепад температур…"
    },
    {
      "ordinal": 46,
      "source_line": 103,
      "speaker_ru": "Амия",
      "text_ru": "Треснувшие стены зданий… Неужели Искусства ФростНовы можно использовать и так…?"
    },
    {
      "ordinal": 47,
      "source_line": 105,
      "speaker_ru": "Блейз",
      "text_ru": "Плохо дело!"
    },
    {
      "ordinal": 48,
      "source_line": 115,
      "speaker_ru": "Блейз",
      "text_ru": "Этот участок земли деформируется!"
    },
    {
      "ordinal": 49,
      "source_line": 117,
      "speaker_ru": "Метеорит",
      "text_ru": "Воссоединение и на такое способно?"
    },
    {
      "ordinal": 50,
      "source_line": 119,
      "speaker_ru": "Блейз",
      "text_ru": "Не знаю, но… весь район проседает!"
    },
    {
      "ordinal": 51,
      "source_line": 121,
      "speaker_ru": "Амия",
      "text_ru": "Бегите! Найдите устойчивую площадку! Земля здесь вот-вот провалится!"
    },
    {
      "ordinal": 52,
      "source_line": 127,
      "speaker_ru": "Джессика",
      "text_ru": "…Доктор?"
    },
    {
      "ordinal": 53,
      "source_line": 128,
      "speaker_ru": "Джессика",
      "text_ru": "Доктор, земля под вами… трескается?"
    },
    {
      "ordinal": 54,
      "source_line": 130,
      "speaker_ru": "Блейз",
      "text_ru": "Вот чёрт."
    },
    {
      "ordinal": 55,
      "source_line": 131,
      "speaker_ru": "Блейз",
      "text_ru": "Доктор {@nickname}, прыгайте сюда!"
    },
    {
      "ordinal": 56,
      "source_line": 138,
      "speaker_ru": "Амия",
      "text_ru": "Доктор!"
    },
    {
      "ordinal": 57,
      "source_line": 140,
      "speaker_ru": "Блейз",
      "text_ru": "Амия, не подходи! Доктор {@nickname}, сначала ухватитесь за тот фонарный столб!"
    },
    {
      "ordinal": 58,
      "source_line": 142,
      "speaker_ru": "Амия",
      "text_ru": "Сначала спасите Доктора!"
    },
    {
      "ordinal": 59,
      "source_line": 144,
      "speaker_ru": "Блейз",
      "text_ru": "Земля слишком быстро раскалывается и кренится! Я не дотянусь!"
    },
    {
      "ordinal": 60,
      "source_line": 146,
      "speaker_ru": "Амия",
      "text_ru": "Тогда я сама!!"
    },
    {
      "ordinal": 61,
      "source_line": 148,
      "speaker_ru": "Блейз",
      "text_ru": "Нельзя!"
    },
    {
      "ordinal": 62,
      "source_line": 150,
      "speaker_ru": "Амия",
      "text_ru": "Что ты сказала?.."
    },
    {
      "ordinal": 63,
      "source_line": 156,
      "speaker_ru": "Амия",
      "text_ru": "Доктор!!"
    },
    {
      "ordinal": 64,
      "source_line": 158,
      "speaker_ru": "Метеорит",
      "text_ru": "Окружающие здания уже не выдерживают собственного веса и рушатся!"
    },
    {
      "ordinal": 65,
      "source_line": 160,
      "speaker_ru": "Блейз",
      "text_ru": "Метеорит, лови!"
    }
  ],
