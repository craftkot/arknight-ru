  "dialogues": [
    {
      "ordinal": 1,
      "source_line": 9,
      "kind": "unnamed",
      "text_ru": "Верхний город Лунмэня. 19:00. Смеркается."
    },
    {
      "ordinal": 2,
      "source_line": 12,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Секретный ордер на арест? На госпожу Чэнь?!"
    },
    {
      "ordinal": 3,
      "source_line": 13,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Неужели ошибка? Да как такое возможно…"
    },
    {
      "ordinal": 4,
      "source_line": 14,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Эй! Вернись! Я спрашиваю, не ошибка ли это?!"
    },
    {
      "ordinal": 5,
      "source_line": 15,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Чёрт, Чэнь, как такое могло случиться… Кто за этим стоит?!"
    },
    {
      "ordinal": 6,
      "source_line": 16,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Нужно найти Чэнь и услышать всё от неё самой!"
    },
    {
      "ordinal": 7,
      "source_line": 24,
      "kind": "named",
      "speaker_cn": "鼠王",
      "text_ru": "…Хорошо. Я понял."
    },
    {
      "ordinal": 8,
      "source_line": 26,
      "kind": "named",
      "speaker_cn": "灰尾",
      "text_ru": "Хозяин, будут ещё распоряжения?"
    },
    {
      "ordinal": 9,
      "source_line": 28,
      "kind": "named",
      "speaker_cn": "鼠王",
      "text_ru": "Нет. Выполни все поручения, которые я дал тебе раньше. А закончив, поскорее заляг на дно."
    },
    {
      "ordinal": 10,
      "source_line": 30,
      "kind": "named",
      "speaker_cn": "灰尾",
      "text_ru": "Есть."
    },
    {
      "ordinal": 11,
      "source_line": 32,
      "kind": "named",
      "speaker_cn": "鼠王",
      "text_ru": "Иди. Живо."
    },
    {
      "ordinal": 12,
      "source_line": 33,
      "kind": "named",
      "speaker_cn": "鼠王",
      "text_ru": "А…"
    },
    {
      "ordinal": 13,
      "source_line": 34,
      "kind": "named",
      "speaker_cn": "鼠王",
      "text_ru": "— Эх. И надо же, нашёлся кто-то, кто сумел переиграть Вэй Яньу."
    },
    {
      "ordinal": 14,
      "source_line": 35,
      "kind": "named",
      "speaker_cn": "鼠王",
      "text_ru": "Талула, Талула… Неужели это и правда судьба?"
    },
    {
      "ordinal": 15,
      "source_line": 36,
      "kind": "named",
      "speaker_cn": "鼠王",
      "text_ru": "Молодой господин, если вы видите нас с того света, вам ведь тоже не хотелось бы видеть такую картину, верно?"
    },
    {
      "ordinal": 16,
      "source_line": 37,
      "kind": "named",
      "speaker_cn": "鼠王",
      "text_ru": "Что ж, что ж. Лунмэнь всё-таки дошёл до этого."
    },
    {
      "ordinal": 17,
      "source_line": 38,
      "kind": "named",
      "speaker_cn": "鼠王",
      "text_ru": "Но Хуэйцзе… Хуэйцзе! Береги себя… Только не погибни!"
    },
    {
      "ordinal": 18,
      "source_line": 44,
      "kind": "unnamed",
      "text_ru": "Стыковочная площадка Лунмэня. 19:20."
    },
    {
      "ordinal": 19,
      "source_line": 47,
      "kind": "named",
      "speaker_cn": "牧群",
      "text_ru": "А… А! Ух, кх…"
    },
    {
      "ordinal": 20,
      "source_line": 49,
      "kind": "named",
      "speaker_cn": "罗德岛干员",
      "text_ru": "Ох, их и правда целая уйма… ЛГД ещё не зачистило этот район?"
    },
    {
      "ordinal": 21,
      "source_line": 50,
      "kind": "named",
      "speaker_cn": "罗德岛干员",
      "text_ru": "Вчера сюда нагрянуло Воссоединение, сегодня — особые заражённые. Даже нам их едва удаётся сдерживать. А использовать в городе тяжёлое вооружение нельзя…"
    },
    {
      "ordinal": 22,
      "source_line": 56,
      "kind": "named",
      "speaker_cn": "迷迭香",
      "text_ru": "Здравствуйте, оператор. Они — наши противники на этот раз?"
    },
    {
      "ordinal": 23,
      "source_line": 58,
      "kind": "named",
      "speaker_cn": "罗德岛干员",
      "text_ru": "Розмонтис! Фух, теперь мы спасены!"
    },
    {
      "ordinal": 24,
      "source_line": 60,
      "kind": "named",
      "speaker_cn": "迷迭香",
      "text_ru": "Это заражённые, преобразованные Искусствами…? И вы не можете сдержать их?"
    },
    {
      "ordinal": 25,
      "source_line": 62,
      "kind": "named",
      "speaker_cn": "罗德岛干员",
      "text_ru": "Да. У нас в основном оборонительное снаряжение. Не ожидали, что даже стальные тросы и сети из высокопрочного волокна почти не помогут против этих заражённых. Похоже, придётся задействовать военное вооружение."
    },
    {
      "ordinal": 26,
      "source_line": 63,
      "kind": "named",
      "speaker_cn": "罗德岛干员",
      "text_ru": "Наша линия обороны испытывает слишком сильное давление, поэтому нам ничего не оставалось, кроме как запросить поддержку у основного корабля. Хорошо, что прислали именно тебя: теперь у нас появился шанс."
    },
    {
      "ordinal": 27,
      "source_line": 64,
      "kind": "named",
      "speaker_cn": "罗德岛干员",
      "text_ru": "Структура Ориджиниума внутри их тел сделала их очень крепкими. Чтобы сдерживать их передвижение, нам приходится вести контролируемый огонь из тяжёлого вооружения. И ещё… мы не обнаруживаем никаких признаков мозговой активности."
    },
    {
      "ordinal": 28,
      "source_line": 65,
      "kind": "named",
      "speaker_cn": "罗德岛干员",
      "text_ru": "Судя по наблюдениям, они, похоже… фактически уже мертвы. Сейчас ими движет лишь какое-то заклинание подчинения. Это ужасно…"
    },
    {
      "ordinal": 29,
      "source_line": 67,
      "kind": "named",
      "speaker_cn": "迷迭香",
      "text_ru": "Тот, кто это сделал… должен заплатить."
    },
    {
      "ordinal": 30,
      "source_line": 68,
      "kind": "named",
      "speaker_cn": "迷迭香",
      "text_ru": "Но ваша безопасность важнее всего."
    },
    {
      "ordinal": 31,
      "source_line": 69,
      "kind": "named",
      "speaker_cn": "迷迭香",
      "text_ru": "Помогите мне составить план. Я… прекращу их буйство."
    },
    {
      "ordinal": 32,
      "source_line": 73,
      "kind": "named",
      "speaker_cn": "迷迭香",
      "text_ru": "Да."
    },
    {
      "ordinal": 33,
      "source_line": 77,
      "kind": "named",
      "speaker_cn": "罗德岛干员",
      "text_ru": "Доктор… вы ведь раньше не встречали Розмонтис?"
    },
    {
      "ordinal": 34,
      "source_line": 79,
      "kind": "named",
      "speaker_cn": "迷迭香",
      "text_ru": "Доктор, пожалуйста, отойдите в сторону."
    },
    {
      "ordinal": 35,
      "source_line": 81,
      "kind": "named",
      "speaker_cn": "罗德岛干员",
      "text_ru": "Тогда будьте осторожны и отойдите подальше. Уверяю, вы ещё никогда не видели ничего подобного."
    },
    {
      "ordinal": 36,
      "source_line": 90,
      "kind": "named",
      "speaker_cn": "迷迭香",
      "text_ru": "Это моё."
    },
    {
      "ordinal": 37,
      "source_line": 91,
      "kind": "named",
      "speaker_cn": "迷迭香",
      "text_ru": "Оператор, опишите мне свои впечатления о цели."
    },
    {
      "ordinal": 38,
      "source_line": 93,
      "kind": "named",
      "speaker_cn": "罗德岛干员",
      "text_ru": "Секунду, загляну в руководство… Так, цель — это, э-э, большое скопление активных и беспокойных особей?"
    },
    {
      "ordinal": 39,
      "source_line": 94,
      "kind": "named",
      "speaker_cn": "罗德岛干员",
      "text_ru": "Двигаются группой, чёткой цели нет; общая тенденция прослеживается, но установленного маршрута нет. Кажется, это всё!"
    },
    {
      "ordinal": 40,
      "source_line": 96,
      "kind": "named",
      "speaker_cn": "迷迭香",
      "text_ru": "— Поняла. Предоставьте это мне."
    }
  ],
