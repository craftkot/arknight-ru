  "dialogues": [
    {
      "ordinal": 1,
      "source_line": 6,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Эно, о чём эта книга?"
    },
    {
      "ordinal": 2,
      "source_line": 7,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Я уже прочитал её, поэтому и принёс тебе."
    },
    {
      "ordinal": 3,
      "source_line": 8,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Думаю, тебе понравится, Саша! Эта книга об идеалах."
    },
    {
      "ordinal": 4,
      "source_line": 9,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Об идеалах?"
    },
    {
      "ordinal": 5,
      "source_line": 10,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Да."
    },
    {
      "ordinal": 6,
      "source_line": 11,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "А какие идеалы у тебя, Эно?"
    },
    {
      "ordinal": 7,
      "source_line": 12,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "…Идеалы, говоришь."
    },
    {
      "ordinal": 8,
      "source_line": 13,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Не знаю. А у меня вообще могут быть идеалы?"
    },
    {
      "ordinal": 9,
      "source_line": 14,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Конечно! Почему же нет?"
    },
    {
      "ordinal": 10,
      "source_line": 15,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Ах, чёрт, уже пора домой..."
    },
    {
      "ordinal": 11,
      "source_line": 16,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Не хочешь уходить?"
    },
    {
      "ordinal": 12,
      "source_line": 17,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "…Не хочу домой."
    },
    {
      "ordinal": 13,
      "source_line": 18,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Но, Эно, ты же говорил: если не вернёшься домой, отец тебя побьёт..."
    },
    {
      "ordinal": 14,
      "source_line": 19,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Но ведь завтра мы снова увидимся, правда? Завтра можно будет встретиться."
    },
    {
      "ordinal": 15,
      "source_line": 20,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Понял. Оставлю здесь книгу и хлеб."
    },
    {
      "ordinal": 16,
      "source_line": 21,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "…Саша, я не хочу уходить. Мне больно. Даже если вернусь сейчас, меня всё равно побьют."
    },
    {
      "ordinal": 17,
      "source_line": 22,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "……"
    },
    {
      "ordinal": 18,
      "source_line": 23,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Тогда приходи завтра. Если тебя снова побьют, можешь ударить меня."
    },
    {
      "ordinal": 19,
      "source_line": 24,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "А?.. Ха-ха-ха! Саша, ты опять подрался? Тебе голову отбили?"
    },
    {
      "ordinal": 20,
      "source_line": 25,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "У тебя столько синяков... столько ран."
    },
    {
      "ordinal": 21,
      "source_line": 26,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Так хотя бы кто-то поймёт, как тебе больно. Хоть кто-то будет знать."
    },
    {
      "ordinal": 22,
      "source_line": 27,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Я понимаю, о чём ты. Но не стану."
    },
    {
      "ordinal": 23,
      "source_line": 28,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Если те ребята снова будут задирать тебя по дороге, скажи мне! Я им всем накостыляю!"
    },
    {
      "ordinal": 24,
      "source_line": 29,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Знаю!"
    },
    {
      "ordinal": 25,
      "source_line": 30,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "До завтра! Я снова приду и спою тебе!"
    },
    {
      "ordinal": 26,
      "source_line": 34,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Я даже не знаю, что с ним случилось."
    },
    {
      "ordinal": 27,
      "source_line": 35,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Знаю только, что он делился со мной едой."
    },
    {
      "ordinal": 28,
      "source_line": 36,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Знаю только, что он умел читать. Я тоже хотел научиться, и он меня учил."
    },
    {
      "ordinal": 29,
      "source_line": 37,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Знаю только, что другие дети задирали его за то, что он приносил мне хлеб. Я был сильнее, давал им отпор — и сам получал от них."
    },
    {
      "ordinal": 30,
      "source_line": 38,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Но что с ним произошло, я так и не знаю."
    },
    {
      "ordinal": 31,
      "source_line": 43,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Мне страшно, Саша. Очень страшно."
    },
    {
      "ordinal": 32,
      "source_line": 44,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Кажется... мне не место в том доме. Я подслушал, что мама... Мамы вообще нет дома."
    },
    {
      "ordinal": 33,
      "source_line": 45,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Они так на меня смотрят... Мне страшно. Я не хочу возвращаться. Не хочу..."
    },
    {
      "ordinal": 34,
      "source_line": 46,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Но здесь нет ни еды, ни места, где можно жить. Здесь только... только канализационные тоннели."
    },
    {
      "ordinal": 35,
      "source_line": 47,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Мне всё равно."
    },
    {
      "ordinal": 36,
      "source_line": 48,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Но..."
    },
    {
      "ordinal": 37,
      "source_line": 49,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "……"
    },
    {
      "ordinal": 38,
      "source_line": 50,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Ты тоже меня ненавидишь?"
    },
    {
      "ordinal": 39,
      "source_line": 51,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Что?.. Почему?"
    },
    {
      "ordinal": 40,
      "source_line": 52,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Потому что я люблю смеяться?"
    },
    {
      "ordinal": 41,
      "source_line": 53,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Нет... Нет. С чего бы мне?"
    },
    {
      "ordinal": 42,
      "source_line": 54,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Потому что мне нельзя смеяться."
    },
    {
      "ordinal": 43,
      "source_line": 55,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Глупости! Эно, ты должен продолжать смеяться."
    },
    {
      "ordinal": 44,
      "source_line": 56,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Правда?"
    },
    {
      "ordinal": 45,
      "source_line": 57,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Правда."
    },
    {
      "ordinal": 46,
      "source_line": 61,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "А что, если бы в тот день он не вернулся домой? Всё могло бы измениться?"
    },
    {
      "ordinal": 47,
      "source_line": 62,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Я отправил его домой только потому, что у меня было слишком грязно и холодно?"
    },
    {
      "ordinal": 48,
      "source_line": 63,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Если бы он тогда не вернулся, разве всё могло бы сложиться иначе?"
    },
    {
      "ordinal": 49,
      "source_line": 68,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Твои раны! Рана на животе... Что случилось? Что с тобой произошло?!"
    },
    {
      "ordinal": 50,
      "source_line": 69,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Саша... Я всё смеялся."
    },
    {
      "ordinal": 51,
      "source_line": 70,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Видишь, ты сказал, что мне можно смеяться, и я продолжал."
    },
    {
      "ordinal": 52,
      "source_line": 71,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Всё смеялся..."
    },
    {
      "ordinal": 53,
      "source_line": 72,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Саша, хочешь ещё послушать, как я пою?"
    },
    {
      "ordinal": 54,
      "source_line": 76,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "После этого он всё ещё время от времени приходил ко мне."
    },
    {
      "ordinal": 55,
      "source_line": 77,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Но шрамов на его теле становилось всё больше..."
    },
    {
      "ordinal": 56,
      "source_line": 78,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Всё больше."
    },
    {
      "ordinal": 57,
      "source_line": 79,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Я понимал, насколько сильно мои слова на него влияют, и стал говорить всё реже."
    },
    {
      "ordinal": 58,
      "source_line": 80,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Может, так станет лучше?"
    },
    {
      "ordinal": 59,
      "source_line": 85,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Твоя спина!"
    },
    {
      "ordinal": 60,
      "source_line": 86,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Твоя спина..."
    },
    {
      "ordinal": 61,
      "source_line": 87,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "……"
    },
    {
      "ordinal": 62,
      "source_line": 88,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "…Больно?"
    },
    {
      "ordinal": 63,
      "source_line": 89,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "……"
    },
    {
      "ordinal": 64,
      "source_line": 90,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Так больше продолжаться не может."
    },
    {
      "ordinal": 65,
      "source_line": 91,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Кто это сделал?! Почему они так с тобой обращаются?!"
    },
    {
      "ordinal": 66,
      "source_line": 92,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Кто бы это ни был... его нужно уничтожить! Что бы это ни было — всё нужно уничтожить!"
    },
    {
      "ordinal": 67,
      "source_line": 93,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Эно, возьми меня с собой!"
    },
    {
      "ordinal": 68,
      "source_line": 94,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "…Ладно."
    },
    {
      "ordinal": 69,
      "source_line": 95,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "А?"
    },
    {
      "ordinal": 70,
      "source_line": 96,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Я это сделаю."
    },
    {
      "ordinal": 71,
      "source_line": 100,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Я не понимал, что сказал."
    },
    {
      "ordinal": 72,
      "source_line": 101,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Не знал даже, могу ли ещё что-нибудь сказать."
    },
    {
      "ordinal": 73,
      "source_line": 102,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Что я наделал? Что же я наделал?"
    },
    {
      "ordinal": 74,
      "source_line": 103,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Я прочитал немало книг, но ни одна не дала мне ответа."
    },
    {
      "ordinal": 75,
      "source_line": 104,
      "kind": "unnamed",
      "speaker_cn": null,
      "text_ru": "Ни одна."
    },
    {
      "ordinal": 76,
      "source_line": 109,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Смотри. Смотри, Саша..."
    },
    {
      "ordinal": 77,
      "source_line": 110,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Ты ведь говорил, что хочешь уничтожить всё, что причиняет мне боль, верно?"
    },
    {
      "ordinal": 78,
      "source_line": 111,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "……"
    },
    {
      "ordinal": 79,
      "source_line": 112,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Иди сюда."
    },
    {
      "ordinal": 80,
      "source_line": 113,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Твои раны..."
    },
    {
      "ordinal": 81,
      "source_line": 114,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Ничего страшного. Всё в порядке."
    },
    {
      "ordinal": 82,
      "source_line": 115,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Смотри, стоит лишь слегка подуть... и всё заживает. Всё будет хорошо."
    },
    {
      "ordinal": 83,
      "source_line": 116,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Иди сюда, я перевяжу тебя! Где-то же должна быть ткань...!"
    },
    {
      "ordinal": 84,
      "source_line": 117,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Тот мужчина порезал мне ногу... Стоило подуть — и всё зажило."
    },
    {
      "ordinal": 85,
      "source_line": 118,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Какой-то старик распорол мне спину. Одно лёгкое прикосновение — и всё прошло."
    },
    {
      "ordinal": 86,
      "source_line": 119,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "И всё это благодаря куску ориджиниума, который та толстая женщина затолкала мне в горло!"
    },
    {
      "ordinal": 87,
      "source_line": 120,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Хватит, Эно. Правда..."
    },
    {
      "ordinal": 88,
      "source_line": 121,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Я больше не могу петь, но посмотри! Всё это благодаря ориджиниуму!"
    },
    {
      "ordinal": 89,
      "source_line": 122,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Теперь я могу всё!"
    },
    {
      "ordinal": 90,
      "source_line": 123,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Эно!"
    },
    {
      "ordinal": 91,
      "source_line": 124,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "…Ты расстроен. Почему? Я ведь сделал всё, как ты говорил."
    },
    {
      "ordinal": 92,
      "source_line": 125,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Почему ты расстроен?"
    },
    {
      "ordinal": 93,
      "source_line": 126,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Но ведь они все довольны. Если делать то, что они говорят, все будут довольны..."
    },
    {
      "ordinal": 94,
      "source_line": 127,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "…Потому что все твои родные — мерзавцы. Все до единого."
    },
    {
      "ordinal": 95,
      "source_line": 128,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Да!"
    },
    {
      "ordinal": 96,
      "source_line": 129,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Поэтому дети их и убили."
    },
    {
      "ordinal": 97,
      "source_line": 130,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "…Что?"
    },
    {
      "ordinal": 98,
      "source_line": 131,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Те дети-инфицированные, которых ещё не выгнали из города..."
    },
    {
      "ordinal": 99,
      "source_line": 132,
      "kind": "named",
      "speaker_cn": "萨沙",
      "text_ru": "Что ты с ними сделал?"
    },
    {
      "ordinal": 100,
      "source_line": 133,
      "kind": "named",
      "speaker_cn": "伊诺",
      "text_ru": "Они тоже били меня. И тебя ранили."
    }
  ],
