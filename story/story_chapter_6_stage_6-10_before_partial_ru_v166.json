    {
      "ordinal": 2,
      "source_line": 6,
      "kind": "unnamed",
      "text_ru": "Я так хочу есть!"
    },
    {
      "ordinal": 3,
      "source_line": 7,
      "kind": "unnamed",
      "text_ru": "А где папа? Куда он ушёл?"
    },
    {
      "ordinal": 4,
      "source_line": 8,
      "kind": "unnamed",
      "text_ru": "Без папы нельзя… Хочу к папе! Папа!"
    },
    {
      "ordinal": 5,
      "source_line": 9,
      "kind": "unnamed",
      "text_ru": "Папа обязательно придёт за мной!"
    },
    {
      "ordinal": 6,
      "source_line": 11,
      "kind": "named",
      "speaker_cn": "灰喉",
      "text_ru": "…!"
    },
    {
      "ordinal": 7,
      "source_line": 12,
      "kind": "named",
      "speaker_cn": "灰喉",
      "text_ru": "Ребёнок?"
    },
    {
      "ordinal": 8,
      "source_line": 14,
      "kind": "named",
      "speaker_cn": "灰喉",
      "text_ru": "Группы Blaze-4 и Amiya-1, докладывает Серая Глотка. В трущобах, среди развалин дома № 10 на Четвёртой улице, обнаружен выживший ребёнок. Заражённый."
    },
    {
      "ordinal": 9,
      "source_line": 20,
      "kind": "named",
      "speaker_cn": "孩童",
      "text_ru": "У-у…"
    },
    {
      "ordinal": 10,
      "source_line": 22,
      "kind": "named",
      "speaker_cn": "灰喉",
      "text_ru": "…Здравствуй."
    },
    {
      "ordinal": 11,
      "source_line": 24,
      "kind": "named",
      "speaker_cn": "孩童",
      "text_ru": "Т-ты кто?"
    },
    {
      "ordinal": 12,
      "source_line": 26,
      "kind": "named",
      "speaker_cn": "孩童",
      "text_ru": "Ты из Лунмэня?"
    },
    {
      "ordinal": 13,
      "source_line": 28,
      "kind": "named",
      "speaker_cn": "灰喉",
      "text_ru": "…Я не причиню тебе вреда. Я плохо говорю по-урсусски. Я не враг."
    },
    {
      "ordinal": 14,
      "source_line": 30,
      "kind": "named",
      "speaker_cn": "孩童",
      "text_ru": "Что ты говоришь?"
    },
    {
      "ordinal": 15,
      "source_line": 32,
      "kind": "named",
      "speaker_cn": "灰喉",
      "text_ru": "Пойдём со мной. Здесь опасно."
    },
    {
      "ordinal": 16,
      "source_line": 34,
      "kind": "named",
      "speaker_cn": "孩童",
      "text_ru": "Дядя велел мне оставаться здесь и никуда не уходить…"
    },
    {
      "ordinal": 17,
      "source_line": 36,
      "kind": "named",
      "speaker_cn": "灰喉",
      "text_ru": "…Но я могу отвести тебя к папе."
    },
    {
      "ordinal": 18,
      "source_line": 38,
      "kind": "named",
      "speaker_cn": "孩童",
      "text_ru": "Правда?"
    },
    {
      "ordinal": 19,
      "source_line": 40,
      "kind": "named",
      "speaker_cn": "灰喉",
      "text_ru": "Правда."
    },
    {
      "ordinal": 20,
      "source_line": 41,
      "kind": "named",
      "speaker_cn": "灰喉",
      "text_ru": "Эй, тот, кто прячется у меня за спиной. Выходи."
    },
    {
      "ordinal": 21,
      "source_line": 43,
      "kind": "named",
      "speaker_cn": "整合运动成员",
      "text_ru": "Ты…"
    },
    {
      "ordinal": 22,
      "source_line": 44,
      "kind": "named",
      "speaker_cn": "整合运动成员",
      "text_ru": "Ты не из тех людей."
    },
    {
      "ordinal": 23,
      "source_line": 45,
      "kind": "named",
      "speaker_cn": "整合运动成员",
      "text_ru": "Ты… ты с Родоса?"
    },
    {
      "ordinal": 24,
      "source_line": 47,
      "kind": "named",
      "speaker_cn": "灰喉",
      "text_ru": "Малыш, отойди подальше. Не приближайся."
    },
    {
      "ordinal": 25,
      "source_line": 48,
      "kind": "named",
      "speaker_cn": "灰喉",
      "text_ru": "Брось оружие и сдавайся."
