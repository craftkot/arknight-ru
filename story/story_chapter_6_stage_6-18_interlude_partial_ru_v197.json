  "dialogues": [
    {
      "ordinal": 1,
      "source_line": 30,
      "kind": "unnamed",
      "text_ru": "Операция по обороне Лунмэня завершена. Повторяю: операция по обороне Лунмэня завершена."
    },
    {
      "ordinal": 2,
      "source_line": 31,
      "kind": "unnamed",
      "text_ru": "Полицейским следует проверить снаряжение, вернуться в свои участки и в течение одного рабочего дня явиться в расположение своих подразделений."
    },
    {
      "ordinal": 3,
      "source_line": 32,
      "kind": "unnamed",
      "text_ru": "Сотрудникам Управления охраны Лунмэня следует собраться со своими отрядами и прибыть в Управление, чтобы ожидать дальнейших приказов."
    },
    {
      "ordinal": 4,
      "source_line": 33,
      "kind": "unnamed",
      "text_ru": "Повторяю…"
    },
    {
      "ordinal": 5,
      "source_line": 37,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Что ты здесь делаешь?"
    },
    {
      "ordinal": 6,
      "source_line": 38,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "…И что это у тебя за выражение лица?"
    },
    {
      "ordinal": 7,
      "source_line": 40,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "…"
    },
    {
      "ordinal": 8,
      "source_line": 41,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Н-ничего."
    },
    {
      "ordinal": 9,
      "source_line": 43,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "…Ясно."
    },
    {
      "ordinal": 10,
      "source_line": 45,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Стой. Куда ты идёшь?"
    },
    {
      "ordinal": 11,
      "source_line": 47,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Проверить."
    },
    {
      "ordinal": 12,
      "source_line": 49,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Не нужно. Я уже всё проверила — там ничего нет."
    },
    {
      "ordinal": 13,
      "source_line": 51,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Вот как."
    },
    {
      "ordinal": 14,
      "source_line": 53,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Чэнь, хватит. Бой уже окончен."
    },
    {
      "ordinal": 15,
      "source_line": 55,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Будь добра, посторонись, мисс Свирь."
    },
    {
      "ordinal": 16,
      "source_line": 57,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Ты остановила Воссоединение, даже их спецотряд!"
    },
    {
      "ordinal": 17,
      "source_line": 58,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Ты вывела их на свет сразу перед Управлением охраны Лунмэня, Родос Айленд и даже Цензором!"
    },
    {
      "ordinal": 18,
      "source_line": 59,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Ты их остановила!"
    },
    {
      "ordinal": 19,
      "source_line": 61,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Отойди!"
    },
    {
      "ordinal": 20,
      "source_line": 63,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Как руководитель специальной инспекционной группы, ты уже сделала достаточно."
    },
    {
      "ordinal": 21,
      "source_line": 65,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Хватит расследовать! Чего ещё ты хочешь узнать? Больше нечего выяснять!"
    },
    {
      "ordinal": 22,
      "source_line": 67,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Я хочу знать, что произошло."
    },
    {
      "ordinal": 23,
      "source_line": 69,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Ты понимаешь, что означает эта система канализации?"
    },
    {
      "ordinal": 24,
      "source_line": 71,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Ты уже сделала достаточно. Ещё один шаг — и окажешься по ту сторону Лунмэня!"
    },
    {
      "ordinal": 25,
      "source_line": 72,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Мы вполне можем сделать Лунмэнь лучше. Отстроить его заново, избавиться от всего, что осталось от прошлого!"
    },
    {
      "ordinal": 26,
      "source_line": 73,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Но, Чэнь, не спускайся туда. Не смотри!"
    },
    {
      "ordinal": 27,
      "source_line": 74,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Чувство справедливости, чувство долга, чувство принадлежности — всё это в тебе есть. В этот раз ты действовала безупречно!"
    },
    {
      "ordinal": 28,
      "source_line": 75,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "А-Чэнь!"
    },
    {
      "ordinal": 29,
      "source_line": 77,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "…"
    },
    {
      "ordinal": 30,
      "source_line": 78,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Отойди."
    },
    {
      "ordinal": 31,
      "source_line": 80,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Ты именно такая, поэтому тебе нельзя это видеть!"
    },
    {
      "ordinal": 32,
      "source_line": 82,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Тебе ведь сказали: «Не расследуй дело с канализацией», верно?"
    },
    {
      "ordinal": 33,
      "source_line": 84,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "…"
    },
    {
      "ordinal": 34,
      "source_line": 86,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Мне сказали то же самое."
    },
    {
      "ordinal": 35,
      "source_line": 88,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "Тогда почему ты продолжаешь расследование?! Никто не хочет, чтобы ты это увидела! Никто!"
    },
    {
      "ordinal": 36,
      "source_line": 90,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Нет."
    },
    {
      "ordinal": 37,
      "source_line": 91,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Сам Лунмэнь хочет, чтобы я увидела. Я такая, какая есть, и должна это увидеть."
    },
    {
      "ordinal": 38,
      "source_line": 92,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Свирь. Не заставляй меня обнажить меч."
    },
    {
      "ordinal": 39,
      "source_line": 94,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "…"
    },
    {
      "ordinal": 40,
      "source_line": 95,
      "kind": "named",
      "speaker_cn": "诗怀雅",
      "text_ru": "У-у…"
    },
    {
      "ordinal": 41,
      "source_line": 104,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Что это за запах?"
    },
    {
      "ordinal": 42,
      "source_line": 106,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "Это…"
    },
    {
      "ordinal": 43,
      "source_line": 108,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "…"
    },
    {
      "ordinal": 44,
      "source_line": 109,
      "kind": "named",
      "speaker_cn": "陈",
      "text_ru": "…………"
    },
    {
      "ordinal": 45,
      "source_line": 119,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "А, вы уже вернулись."
    },
    {
      "ordinal": 46,
      "source_line": 120,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Командира противника — заражённого по имени Мефисто — поймали?"
    },
    {
      "ordinal": 47,
      "source_line": 123,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Что… Что вы сказали? И это вы называете сотрудничеством?.."
    },
    {
      "ordinal": 48,
      "source_line": 124,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Как так? Разве вы, сотрудники Родос Айленд, не отправились за ним?"
    },
    {
      "ordinal": 49,
      "source_line": 126,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "…Можете дать точный ответ?"
    },
    {
      "ordinal": 50,
      "source_line": 127,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Нам ведь нужно отчитаться. И если вражеский командир не был убит…"
    },
    {
      "ordinal": 51,
      "source_line": 129,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Мёртв? Как он умер?"
    },
    {
      "ordinal": 52,
      "source_line": 130,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Вы уверены? Установить личность заражённого можно только по кристаллическим останкам и результатам вскрытия. Орипатия стирает первичные биологические признаки…"
    },
    {
      "ordinal": 53,
      "source_line": 131,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "Вы ведь это знаете, верно?"
    },
    {
      "ordinal": 54,
      "source_line": 133,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "А? Постойте, куда вы? Кого это вы несёте?"
    },
    {
      "ordinal": 55,
      "source_line": 134,
      "kind": "named",
      "speaker_cn": "近卫局成员",
      "text_ru": "…Что же там внизу произошло?"
    }
  ],
