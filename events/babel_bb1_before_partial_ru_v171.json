  "unnamed_opening": {
    "source_line": 17,
    "text_ru": "Каздель, Рынок Шрамов"
  },
  "dialogues": [
    {
      "ordinal": 1,
      "source_line": 27,
      "kind": "named",
      "speaker_cn": "负伤的雇佣兵",
      "text_ru": "Береги жетон на шее как зеницу ока! Ты моя драгоценная собственность, раб!"
    },
    {
      "ordinal": 2,
      "source_line": 29,
      "kind": "named",
      "speaker_cn": "负伤的雇佣兵",
      "text_ru": "Понял меня?! *Сарказские ругательства* Надеюсь, ты хоть чего-нибудь стоишь."
    },
    {
      "ordinal": 3,
      "source_line": 35,
      "kind": "named",
      "speaker_cn": "胆怯的奴隶",
      "text_ru": "…"
    },
    {
      "ordinal": 4,
      "source_line": 37,
      "kind": "named",
      "speaker_cn": "负伤的雇佣兵",
      "text_ru": "Стой здесь и не двигайся. Это ты проверяешь товар?"
    },
    {
      "ordinal": 5,
      "source_line": 42,
      "kind": "unnamed",
      "text_ru": "Торговец рабами лишь мельком взглянул на молчаливого невольника за спиной наёмника и слегка покачал головой."
    },
    {
      "ordinal": 6,
      "source_line": 43,
      "kind": "named",
      "speaker_cn": "奴隶商人",
      "text_ru": "Откуда товар?"
    },
    {
      "ordinal": 7,
      "source_line": 45,
      "kind": "named",
      "speaker_cn": "负伤的雇佣兵",
      "text_ru": "По дороге он чуть не умер от жажды. Я вытащил его прямо из когтей раздира."
    },
    {
      "ordinal": 8,
      "source_line": 47,
      "kind": "named",
      "speaker_cn": "胆怯的奴隶",
      "text_ru": "Я… из Казделя… Я могу найти кого-нибудь…"
    },
    {
      "ordinal": 9,
      "source_line": 49,
      "kind": "named",
      "speaker_cn": "奴隶商人",
      "text_ru": "Нам плевать, откуда ты, раб. Если кто-нибудь придёт тебя выкупить, можешь хоть сказать, что ты из Хигаси."
    },
    {
      "ordinal": 10,
      "source_line": 50,
      "kind": "named",
      "speaker_cn": "奴隶商人",
      "text_ru": "Я лишь проверяю, не тянется ли за тобой хвост. Эти наёмники вечно действуют не подумав."
    },
    {
      "ordinal": 11,
      "source_line": 52,
      "kind": "named",
      "speaker_cn": "负伤的雇佣兵",
      "text_ru": "Ручаюсь, товар чистый."
    },
    {
      "ordinal": 12,
      "source_line": 54,
      "kind": "named",
      "speaker_cn": "奴隶商人",
      "text_ru": "Надеюсь, ты не врёшь. Деньги или обмен?"
    },
    {
      "ordinal": 13,
      "source_line": 56,
      "kind": "named",
      "speaker_cn": "负伤的雇佣兵",
      "text_ru": "До того дня, когда я смогу потратить деньги, могу и не дожить. Лучше дай мне хорошее оружие."
    },
    {
      "ordinal": 14,
      "source_line": 58,
      "kind": "named",
      "speaker_cn": "奴隶商人",
      "text_ru": "Как скажешь. Он едва тянет на второй сорт. Дам за него два свежевыкованных клинка."
    },
    {
      "ordinal": 15,
      "source_line": 62,
      "kind": "named",
      "speaker_cn": "负伤的雇佣兵",
      "text_ru": "…Посмотри на мой товар повнимательнее!"
    },
    {
      "ordinal": 16,
      "source_line": 64,
      "kind": "named",
      "speaker_cn": "奴隶商人",
      "text_ru": "Хоть наряди второсортный товар в дорогие одежды, второсортным он и останется. Не устраивает цена — проваливай."
    },
    {
      "ordinal": 17,
      "source_line": 65,
      "kind": "named",
      "speaker_cn": "奴隶商人",
      "text_ru": "И убери свой клинок…"
    },
    {
      "ordinal": 18,
      "source_line": 66,
      "kind": "named",
      "speaker_cn": "奴隶商人",
      "text_ru": "Это Рынок Шрамов."
    }
  ],
