  "dialogues": [
    {
      "ordinal": 1,
      "source_line": 10,
      "kind": "unnamed",
      "text_ru": "Осень 1091 года."
    },
    {
      "ordinal": 2,
      "source_line": 11,
      "kind": "unnamed",
      "text_ru": "Каздель. Главный корабль «Родос Айленд» организации «Бабель»."
    },
    {
      "ordinal": 3,
      "source_line": 15,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Клозур, как продвигается работа?"
    },
    {
      "ordinal": 4,
      "source_line": 16,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Я не хочу, чтобы система управления кораблём снова вышла из-под контроля."
    },
    {
      "ordinal": 5,
      "source_line": 21,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Ну… ха-ха, раз уж ты спросила, возникли кое-какие небольшие сложности."
    },
    {
      "ordinal": 6,
      "source_line": 22,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Даже с твоими подсказками многие способы шифрования программ PRTS обычному человеку просто не понять. Мой дешифратор пока не полностью с ними совместим."
    },
    {
      "ordinal": 7,
      "source_line": 23,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Похоже, мы не успеем полностью отключить систему до прибытия Доктора на борт."
    },
    {
      "ordinal": 8,
      "source_line": 25,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Попробуй ещё раз."
    },
    {
      "ordinal": 9,
      "source_line": 26,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Если уверенности всё равно не будет, готовь запасной план… Полностью отключим энергоснабжение корабля."
    },
    {
      "ordinal": 10,
      "source_line": 28,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Можешь на меня положиться!"
    },
    {
      "ordinal": 11,
      "source_line": 29,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Но… похоже, ты ещё многое скрываешь, Кальцит."
    },
    {
      "ordinal": 12,
      "source_line": 30,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Никогда не видела, чтобы кто-то заставлял тебя так нервничать."
    },
    {
      "ordinal": 13,
      "source_line": 32,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "…Это неважно, Клозур."
    },
    {
      "ordinal": 14,
      "source_line": 33,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Важно, чтобы с кораблём ничего не случилось."
    },
    {
      "ordinal": 15,
      "source_line": 35,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Хм, судя по отчёту Аскалон, Доктор — обычный человек. Да ещё и добряк, который таскает на спине бедную маленькую крольчиху и странствует с ней где попало."
    },
    {
      "ordinal": 16,
      "source_line": 36,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Разве нам нужно так его опасаться?"
    },
    {
      "ordinal": 17,
      "source_line": 38,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Угроза исходит не от Доктора."
    },
    {
      "ordinal": 18,
      "source_line": 40,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Тогда от чего?"
    },
    {
      "ordinal": 19,
      "source_line": 42,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Тебе пока незачем это знать."
    },
    {
      "ordinal": 20,
      "source_line": 43,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Ради безопасности Доктора и членов «Бабеля» удали запись о его прибытии на корабль."
    },
    {
      "ordinal": 21,
      "source_line": 44,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Пока Доктор и Терезия не придут к решению, остальным не нужно знать о его существовании."
    },
    {
      "ordinal": 22,
      "source_line": 46,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Ладно, ладно, постараюсь ещё усерднее…"
    },
    {
      "ordinal": 23,
      "source_line": 47,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Но ты явно беспокоишься о Докторе и при этом так настороженно к нему относишься…"
    },
    {
      "ordinal": 24,
      "source_line": 48,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "А-а! Может, у Доктора на тебя есть какой-нибудь компромат?!"
    },
    {
      "ordinal": 25,
      "source_line": 50,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Даже не пытайся расследовать. Ничего не найдёшь."
    },
    {
      "ordinal": 26,
      "source_line": 52,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Э-э… Зачем же так серьёзно?"
    },
    {
      "ordinal": 27,
      "source_line": 54,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "И ещё… Что удалось выяснить о происхождении спасённой девочки?"
    },
    {
      "ordinal": 28,
      "source_line": 56,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Вывод прежний."
    },
    {
      "ordinal": 29,
      "source_line": 57,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Я неоднократно сверила все документы, связанные с Рим Биллитоном того времени, а ещё попросила Скаута и наших осведомителей в Военной комиссии всё проверить."
    },
    {
      "ordinal": 30,
      "source_line": 58,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "С происхождением Амии всё в порядке."
    },
    {
      "ordinal": 31,
      "source_line": 59,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Её родители действительно погибли при нападении на колонну, перевозившую для нас модуль лазерной добычи. Нападение на них было чистой случайностью."
    },
    {
      "ordinal": 32,
      "source_line": 60,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Никто не знал, что они везут груз, связанный с сарказами. Военная комиссия тоже не устраивала это нападение намеренно."
    },
    {
      "ordinal": 33,
      "source_line": 61,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Скорее всего, именно тогда она и заразилась орипатией. Если бы не Доктор… вероятно, остаток жизни она провела бы в страданиях в Рим Биллитоне."
    },
    {
      "ordinal": 34,
      "source_line": 63,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Когда девочка поднимется на корабль, я лично займусь её обследованием и планом лечения."
    },
    {
      "ordinal": 35,
      "source_line": 65,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "Ты всё ещё не доверяешь этой девочке?"
    },
    {
      "ordinal": 36,
      "source_line": 67,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Я беспокоюсь о ней."
    },
    {
      "ordinal": 37,
      "source_line": 68,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Она слишком мала и после заражения орипатией так и не получила должного лечения."
    },
    {
      "ordinal": 38,
      "source_line": 70,
      "kind": "named",
      "speaker_cn": "可露希尔",
      "text_ru": "А-а, вот в каком смысле «беспокоишься»."
    },
    {
      "ordinal": 39,
      "source_line": 72,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Я не хочу, чтобы доброта Доктора стала причиной промедления с её лечением. И ещё…"
    },
    {
      "ordinal": 40,
      "source_line": 73,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "…Терезия сказала бы, что эта девочка добрая и имеет право сама выбирать своё будущее."
    },
    {
      "ordinal": 41,
      "source_line": 82,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Амия, Амия."
    },
    {
      "ordinal": 42,
      "source_line": 83,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "…Так спать хочется… Я… где я?"
    },
    {
      "ordinal": 43,
      "source_line": 84,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Доктор… Доктор?"
    },
    {
      "ordinal": 44,
      "source_line": 85,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Доктор здесь, рядом."
    },
    {
      "ordinal": 45,
      "source_line": 86,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Соня, просыпайся. Ты уже почти дома."
    },
    {
      "ordinal": 46,
      "source_line": 87,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Дома?"
    },
    {
      "ordinal": 47,
      "source_line": 88,
      "kind": "unnamed",
      "text_ru": "Сквозь сон Амия чувствует, как тёплые пальцы касаются её щеки."
    },
    {
      "ordinal": 48,
      "source_line": 89,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Щекотно! Ха-ха, не щекочи меня за шею."
    },
    {
      "ordinal": 49,
      "source_line": 90,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Ай!"
    },
    {
      "ordinal": 50,
      "source_line": 91,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Т-ты кто?"
    },
    {
      "ordinal": 51,
      "source_line": 92,
      "kind": "named",
      "speaker_cn": "？？？",
      "text_ru": "Терезия. Меня зовут Терезия."
    },
    {
      "ordinal": 52,
      "source_line": 93,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Терезия… Доктор мне о тебе рассказывал…"
    },
    {
      "ordinal": 53,
      "source_line": 94,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "О? И что же Доктор обо мне говорил?"
    },
    {
      "ordinal": 54,
      "source_line": 95,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "М-м… Забыла… Но я тогда ела такой вкусный морковный торт…"
    },
    {
      "ordinal": 55,
      "source_line": 96,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Наверное, Терезия должна быть… душистой… сладкой… и очень тёплой."
    },
    {
      "ordinal": 56,
      "source_line": 97,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "А сейчас? Я такая, какой ты меня представляла?"
    },
    {
      "ordinal": 57,
      "source_line": 98,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Угу… Тоже душистая… сладкая… тёплая… Только морковкой не пахнет…"
    },
    {
      "ordinal": 58,
      "source_line": 99,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Хе-хе, похоже, ты ещё не совсем проснулась."
    },
    {
      "ordinal": 59,
      "source_line": 100,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Маленькая Амия, хочешь отправиться домой вместе с нами?"
    },
    {
      "ordinal": 60,
      "source_line": 101,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Домой… угу… хорошо…"
    },
    {
      "ordinal": 61,
      "source_line": 111,
      "kind": "unnamed",
      "text_ru": "Каздель. У главного корабля «Родос Айленд» организации «Бабель»."
    },
    {
      "ordinal": 62,
      "source_line": 117,
      "kind": "unnamed",
      "text_ru": "Маленькая каутус крепко спит на руках у Терезии, обвив её шею руками."
    },
    {
      "ordinal": 63,
      "source_line": 118,
      "kind": "unnamed",
      "text_ru": "Терезия нежно похлопывает Амию по спине и поворачивается к стоящему рядом Доктору, который выглядит немного уставшим."
    },
    {
      "ordinal": 64,
      "source_line": 120,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Спасибо, что специально сошла с корабля, чтобы встретить нас… Терезия."
    },
    {
      "ordinal": 65,
      "source_line": 122,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Выходит, даже ты знаешь не всё на свете, Доктор."
    },
    {
      "ordinal": 66,
      "source_line": 123,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "По крайней мере, тебе ещё многому предстоит научиться в уходе за детьми."
    },
    {
      "ordinal": 67,
      "source_line": 125,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "…Безусловно."
    },
    {
      "ordinal": 68,
      "source_line": 127,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Ты очень изменился с тех пор, как ушёл, Доктор. Как прошло путешествие?"
    },
    {
      "ordinal": 69,
      "source_line": 129,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Я многое увидел и многому научился… На этой земле столько интересного."
    },
    {
      "ordinal": 70,
      "source_line": 130,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "И ещё я встретил Амию… То, что мне удалось спасти её во время той катастрофы, — настоящее чудо."
    },
    {
      "ordinal": 71,
      "source_line": 132,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Амия… Она даже милее, чем ты описывал в письмах. Бедная девочка, но в каком-то смысле ей повезло."
    },
    {
      "ordinal": 72,
      "source_line": 134,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Её болезнь неизбежно прогрессирует. Мне нужно было привезти её сюда на лечение."
    },
    {
      "ordinal": 73,
      "source_line": 135,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "А пока меня не было, как дела у «Бабеля»?.."
    },
    {
      "ordinal": 74,
      "source_line": 137,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Не всё шло гладко. Мы столкнулись со многими трудностями, но решать их все прямо сейчас необязательно."
    },
    {
      "ordinal": 75,
      "source_line": 139,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "После такого долгого пути вы наверняка устали. Сперва отдохните."
    },
    {
      "ordinal": 76,
      "source_line": 141,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Большое спасибо, Терезия."
    },
    {
      "ordinal": 77,
      "source_line": 142,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Амия, мы дома."
    },
    {
      "ordinal": 78,
      "source_line": 147,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "М-м… Доктор, ты меня зовёшь?.. Я что, уснула?"
    },
    {
      "ordinal": 79,
      "source_line": 151,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "О, маленькая Амия, ты проснулась."
    },
    {
      "ordinal": 80,
      "source_line": 153,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Амия, может, спустишься? Терезия устанет, если будет всё время держать тебя на руках."
    },
    {
      "ordinal": 81,
      "source_line": 157,
      "kind": "unnamed",
      "text_ru": "Амия послушно кивает, спрыгивает с рук Терезии и, встав на землю, несколько раз подпрыгивает."
    },
    {
      "ordinal": 82,
      "source_line": 164,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Амия, можно я возьму тебя за руку?"
    },
    {
      "ordinal": 83,
      "source_line": 166,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Доктор?.."
    },
    {
      "ordinal": 84,
      "source_line": 168,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Конечно. Терезия — моя подруга, ей можно доверять. Теперь она тоже долго будет рядом с тобой."
    },
    {
      "ordinal": 85,
      "source_line": 170,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Угу…"
    },
    {
      "ordinal": 86,
      "source_line": 175,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Это и есть «Бабель»?"
    },
    {
      "ordinal": 87,
      "source_line": 177,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Да."
    },
    {
      "ordinal": 88,
      "source_line": 179,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Какой огромный… Даже больше тех горнодобывающих участков… Значит, раньше Доктор жил в таком месте."
    },
    {
      "ordinal": 89,
      "source_line": 181,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Я прожил здесь очень… очень долго, Амия."
    },
    {
      "ordinal": 90,
      "source_line": 183,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Это дом Доктора?"
    },
    {
      "ordinal": 91,
      "source_line": 185,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "…"
    },
    {
      "ordinal": 92,
      "source_line": 187,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Верно, Амия. Это дом, в котором Доктор прожил очень долго. Правда, Доктор?"
    },
    {
      "ordinal": 93,
      "source_line": 189,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "…Да."
    },
    {
      "ordinal": 94,
      "source_line": 191,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Отныне это будет и твой дом. Позволишь нам вместе с Доктором заботиться о тебе?"
    },
    {
      "ordinal": 95,
      "source_line": 193,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Хорошо… Где Доктор, там и я."
    },
    {
      "ordinal": 96,
      "source_line": 206,
      "kind": "unnamed",
      "text_ru": "Они ступают на подъёмную платформу, и перед ними медленно возникает эмблема «Бабеля»."
    },
    {
      "ordinal": 97,
      "source_line": 207,
      "kind": "unnamed",
      "text_ru": "Тяжёлая дверь медленно открывается, словно приветствуя их прибытие."
    },
    {
      "ordinal": 98,
      "source_line": 208,
      "kind": "unnamed",
      "text_ru": "Почувствовав робость Амии, Терезия осторожно кладёт руку ей на плечо."
    },
    {
      "ordinal": 99,
      "source_line": 209,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "А что… за этой дверью?"
    },
    {
      "ordinal": 100,
      "source_line": 210,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "За ней — все те, кто рад встретить Амию и Доктора."
    },
    {
      "ordinal": 101,
      "source_line": 211,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Ты не сомневаешься, Терезия? Ты официально принимаешь и меня, и этого ребёнка."
    },
    {
      "ordinal": 102,
      "source_line": 212,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "В чём тут сомневаться? Я рада, что «Бабель» может стать домом для стольких людей."
    },
    {
      "ordinal": 103,
      "source_line": 213,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Правда, многие здесь ещё не знают тебя. Боюсь, ближайшие несколько дней у тебя будут очень хлопотными."
    },
    {
      "ordinal": 104,
      "source_line": 214,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "В каком качестве мне следует предстать перед ними?"
    },
    {
      "ordinal": 105,
      "source_line": 215,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Непростой вопрос. Но думаю, сперва тебе стоит поговорить с Кальцит. Она всё это время тебя ждала."
    },
    {
      "ordinal": 106,
      "source_line": 216,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "…"
    },
    {
      "ordinal": 107,
      "source_line": 217,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Доктор, расскажи Кальцит о своих тревогах, сомнениях и тайнах, которые прячешь глубоко в сердце."
    },
    {
      "ordinal": 108,
      "source_line": 218,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Иначе ей будет очень больно."
    },
    {
      "ordinal": 109,
      "source_line": 219,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Ты ведь могла бы…"
    },
    {
      "ordinal": 110,
      "source_line": 220,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Если ты действительно хочешь, чтобы «Владычица демонов» раскрыла мысли, о которых ты не желаешь говорить, я сделаю это. Но я чувствую: ты всё ещё колеблешься."
    },
    {
      "ordinal": 111,
      "source_line": 221,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "text_ru": "Пойдём, Амия, Доктор. Давайте встретимся с ней."
    },
    {
      "ordinal": 112,
      "source_line": 233,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Амия. Ты ведь Амия, верно?"
    },
    {
      "ordinal": 113,
      "source_line": 235,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Угу…"
    },
    {
      "ordinal": 114,
      "source_line": 237,
      "kind": "unnamed",
      "text_ru": "Кальцит присела на корточки, достала из кармана заранее приготовленную конфету и протянула её девочке."
    },
    {
      "ordinal": 115,
      "source_line": 240,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Амия, спасибо, что оберегала Доктора на протяжении всего пути."
    },
    {
      "ordinal": 116,
      "source_line": 242,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Спасибо… доктор Кальцит."
    },
    {
      "ordinal": 117,
      "source_line": 244,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Можешь пойти к госпоже Терезии? Нам нужно провести несколько обследований."
    },
    {
      "ordinal": 118,
      "source_line": 246,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Обследования… Это будет больно?"
    },
    {
      "ordinal": 119,
      "source_line": 248,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Будет больно. Но я знаю, что ты стойкая девочка: Доктор уже написал мне об этом."
    },
    {
      "ordinal": 120,
      "source_line": 250,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "Доктор будет рядом со мной?"
    },
    {
      "ordinal": 121,
      "source_line": 252,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Конечно. Но сначала Доктору нужно кое-что сделать."
    },
    {
      "ordinal": 122,
      "source_line": 254,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "…"
    },
    {
      "ordinal": 123,
      "source_line": 257,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Всё хорошо, Амия. Подожди меня немного в палате, я скоро к тебе приду."
    },
    {
      "ordinal": 124,
      "source_line": 261,
      "kind": "named",
      "speaker_cn": "阿米娅",
      "text_ru": "…Хорошо."
    },
    {
      "ordinal": 125,
      "source_line": 267,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Доктор, позже тебе тоже придётся пройти полное обследование."
    },
    {
      "ordinal": 126,
      "source_line": 270,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Хорошо."
    },
    {
      "ordinal": 127,
      "source_line": 272,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "…Доктор."
    },
    {
      "ordinal": 128,
      "source_line": 274,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Да?"
    },
    {
      "ordinal": 129,
      "source_line": 276,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Ты собираешься снова уехать?"
    },
    {
      "ordinal": 130,
      "source_line": 278,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Нет. Думаю, этого путешествия мне уже достаточно."
    },
    {
      "ordinal": 131,
      "source_line": 280,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Если ты окончательно решил, я уважаю твой выбор."
    },
    {
      "ordinal": 132,
      "source_line": 281,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "По крайней мере, тебе небезразлично здоровье Амии… хотя прежде вас ничто не связывало."
    },
    {
      "ordinal": 133,
      "source_line": 283,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Эти новые жизни по своей сути ничем не отличаются от нас."
    },
    {
      "ordinal": 134,
      "source_line": 285,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "…Я рада."
    },
    {
      "ordinal": 135,
      "source_line": 286,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "Ты всё-таки выбрал надежду."
    },
    {
      "ordinal": 136,
      "source_line": 288,
      "kind": "named",
      "speaker_cn": "凯尔希",
      "text_ru": "С возвращением, Dr.{@nickname}."
    }
  ]
}
