  "dialogues": [
    {
      "ordinal": 1,
      "source_line": 16,
      "kind": "named",
      "speaker_cn": "萨卡兹平民",
      "text_ru": "Впереди! Смотрите, что впереди!"
    },
    {
      "ordinal": 2,
      "source_line": 17,
      "kind": "named",
      "speaker_cn": "萨卡兹平民",
      "text_ru": "Мост… его взорвали? Как нам теперь перебраться?"
    },
    {
      "ordinal": 3,
      "source_line": 18,
      "kind": "named",
      "speaker_cn": "萨卡兹平民",
      "text_ru": "У нас… у нас есть другой путь? Мы столько шли, а облако Катастрофы всё ещё прямо над нами…"
    },
    {
      "ordinal": 4,
      "source_line": 19,
      "kind": "named",
      "speaker_cn": "萨卡兹平民",
      "text_ru": "С нами раненые и дети… Мы… мы больше не можем идти…"
    },
    {
      "ordinal": 5,
      "source_line": 29,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Проклятье! В лесу и на лугах повсюду кристаллы оригиния. Они… они уже начинают светиться."
    },
    {
      "ordinal": 6,
      "source_line": 30,
      "kind": "multiline",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Эта взрывчатка, пришедшая в активное состояние, убьёт нас раньше, чем разразится Катастрофа…"
    },
    {
      "ordinal": 7,
      "source_line": 31,
      "kind": "multiline",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Кхе."
    },
    {
      "ordinal": 8,
      "source_line": 32,
      "kind": "multiline",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Нам нужно немедленно…"
    },
    {
      "ordinal": 9,
      "source_line": 34,
      "kind": "multiline",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Кхе-кхе…"
    },
    {
      "ordinal": 10,
      "source_line": 36,
      "kind": "multiline",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Кхе-кхе-кхе…"
    },
    {
      "ordinal": 11,
      "source_line": 37,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "…Нет, нет, больше нельзя медлить. В воздухе сплошные частицы оригиния, *сарказское ругательство*."
    },
    {
      "ordinal": 12,
      "source_line": 38,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Уже семь-восемь дней без поставок лекарств… Раненые в отряде… инфекция… Проклятье!"
    },
    {
      "ordinal": 13,
      "source_line": 43,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Ч-что это за звук?"
    },
    {
      "ordinal": 14,
      "source_line": 57,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵",
      "text_ru": "Помощь от «Бабеля» ещё не пришла? Нет? Тогда пусть разведчики продолжают искать дорогу! Пока не найдут — пусть не возвращаются!"
    },
    {
      "ordinal": 15,
      "source_line": 58,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵",
      "text_ru": "Тьфу! Облако Катастрофы уже сформировалось. Какая *сарказское ругательство* часть напала на медицинский пункт?! Даже «Шрамоглазый» не настолько безумен!"
    },
    {
      "ordinal": 16,
      "source_line": 59,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵",
      "text_ru": "Все сзади, не отставайте! Мы уже не успеем выйти из зоны Катастрофы. Придётся найти несколько чистых пещер и укрыться! Ни следа оригиния внутри — ни малейшего!"
    },
    {
      "ordinal": 17,
      "source_line": 60,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵",
      "text_ru": "…Проклятье! Даже раненых не пощадили. Терезис, ну и мразь же ты…"
    },
    {
      "ordinal": 18,
      "source_line": 72,
      "kind": "named",
      "speaker_cn": "萨卡兹孩子",
      "text_ru": "Мама… больно… нога болит…"
    },
    {
      "ordinal": 19,
      "source_line": 74,
      "kind": "named",
      "speaker_cn": "萨卡兹平民",
      "text_ru": "Не… не плачь, малыш. Потерпи ещё немного, и мы вернёмся домой…"
    },
    {
      "ordinal": 20,
      "source_line": 76,
      "kind": "multiline",
      "speaker_cn": "萨卡兹孩子",
      "text_ru": "Нет… нет…"
    },
    {
      "ordinal": 21,
      "source_line": 77,
      "kind": "multiline",
      "speaker_cn": "萨卡兹孩子",
      "text_ru": "А-а-а! Больно… больно…"
    },
    {
      "ordinal": 22,
      "source_line": 87,
      "kind": "narration",
      "text_ru": "Детский плач."
    },
    {
      "ordinal": 23,
      "source_line": 88,
      "kind": "narration",
      "text_ru": "Звуки заговора, смерти и отчаянной борьбы за жизнь."
    },
    {
      "ordinal": 24,
      "source_line": 89,
      "kind": "narration",
      "text_ru": "Катастрофа безжалостна: она лишь поглощает ветер и снег, взращивая бурю."
    },
    {
      "ordinal": 25,
      "source_line": 101,
      "kind": "narration",
      "text_ru": "На далёком утёсе виднеются несколько человеческих фигур."
    },
    {
      "ordinal": 26,
      "source_line": 102,
      "kind": "narration",
      "text_ru": "Среди сурового ветра и снега женщина у края обрыва молча смотрит вдаль."
    },
    {
      "ordinal": 27,
      "source_line": 103,
      "kind": "narration",
      "text_ru": "Безжалостная Катастрофа, вражеские солдаты на ключевых путях, разбегающиеся звери, раненые и мирные жители, которым некуда бежать."
    },
    {
      "ordinal": 28,
      "source_line": 104,
      "kind": "narration",
      "text_ru": "Жизни отзываются эхом в пустой долине и достигают слуха Мантры. Это…"
    },
    {
      "ordinal": 29,
      "source_line": 105,
      "kind": "narration",
      "text_ru": "…детский плач."
    },
    {
      "ordinal": 30,
      "source_line": 108,
      "kind": "named",
      "speaker_cn": "Mantra",
      "text_ru": "…Я слышу."
    },
    {
      "ordinal": 31,
      "source_line": 109,
      "kind": "named",
      "speaker_cn": "Mantra",
      "text_ru": "Плачут дети."
    },
    {
      "ordinal": 32,
      "source_line": 114,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "Начинается снегопад. Дела плохи."
    },
    {
      "ordinal": 33,
      "source_line": 116,
      "kind": "named",
      "speaker_cn": "Mantra",
      "text_ru": "Две тысячи триста тринадцать человек."
    },
    {
      "ordinal": 34,
      "source_line": 117,
      "kind": "named",
      "speaker_cn": "Mantra",
      "text_ru": "Все подтверждены."
    },
    {
      "ordinal": 35,
      "source_line": 119,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "…Местоположение и показатели жизнедеятельности — всё внесено."
    },
    {
      "ordinal": 36,
      "source_line": 124,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "Потерь меньше, чем мы ожидали, но нужно спешить."
    },
    {
      "ordinal": 37,
      "source_line": 125,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "Мантра, видеть твои Искусства вблизи — по-прежнему поразительное зрелище."
    },
    {
      "ordinal": 38,
      "source_line": 127,
      "kind": "named",
      "speaker_cn": "Mantra",
      "text_ru": "(Скромно кивает в ответ.)"
    },
    {
      "ordinal": 39,
      "source_line": 129,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "Та джалль из отдела кадров так и не подобрала тебе нескольких толковых связистов?"
    },
    {
      "ordinal": 40,
      "source_line": 131,
      "kind": "named",
      "speaker_cn": "Mantra",
      "text_ru": "(Слегка прикрывает глаза.)"
    },
    {
      "ordinal": 41,
      "source_line": 133,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "Жаль."
    },
    {
      "ordinal": 42,
      "source_line": 134,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "…Данные отправлены всем оперативным группам."
    },
    {
      "ordinal": 43,
      "source_line": 136,
      "kind": "named",
      "speaker_cn": "Mantra",
      "text_ru": "На северо-востоке. Семь километров. Пещера."
    },
    {
      "ordinal": 44,
      "source_line": 137,
      "kind": "named",
      "speaker_cn": "Mantra",
      "text_ru": "Дети там."
    },
    {
      "ordinal": 45,
      "source_line": 139,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "Но разведывательные беспилотники Военной комиссии уже обнаружили нас."
    },
    {
      "ordinal": 46,
      "source_line": 140,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "Я останусь. А ты иди."
    },
    {
      "ordinal": 47,
      "source_line": 142,
      "kind": "named",
      "speaker_cn": "Mantra",
      "text_ru": "(Хмурится.)"
    },
    {
      "ordinal": 48,
      "source_line": 144,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "На такой местности они не рискнут вступить в открытый бой с моим отрядом."
    },
    {
      "ordinal": 49,
      "source_line": 145,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "Не волнуйся. Просто поздороваюсь. Если ими командует Манфред, попробую взять его живым."
    },
    {
      "ordinal": 50,
      "source_line": 147,
      "kind": "named",
      "speaker_cn": "Mantra",
      "text_ru": "Не рискуй зря…"
    },
    {
      "ordinal": 51,
      "source_line": 153,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Коллеги, это я."
    },
    {
      "ordinal": 52,
      "source_line": 154,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Простите, что задержался. Операция в строительном районе CA завершена."
    },
    {
      "ordinal": 53,
      "source_line": 155,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Продолжайте действовать по первоначальному плану Мантры. Я помогу с другого направления. Главное — спасти раненых и мирных жителей."
    },
    {
      "ordinal": 54,
      "source_line": 158,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "Вовремя появляешься, Доктор."
    },
    {
      "ordinal": 55,
      "source_line": 160,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Спасибо. Мизери отвлекает внимание Военной комиссии, но ему понадобятся помощники."
    },
    {
      "ordinal": 56,
      "source_line": 162,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "Тогда как раз кстати?"
    },
    {
      "ordinal": 57,
      "source_line": 164,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Именно так, Эйс."
    },
    {
      "ordinal": 58,
      "source_line": 166,
      "kind": "named",
      "speaker_cn": "Ace",
      "text_ru": "Жду приказа."
    },
    {
      "ordinal": 59,
      "source_line": 168,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "И ещё…"
    },
    {
      "ordinal": 60,
      "source_line": 169,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Терезия направится прямо в пострадавший медицинский пункт в центре, чтобы не допустить новых потерь."
    },
    {
      "ordinal": 61,
      "source_line": 170,
      "kind": "named",
      "speaker_cn": "博士",
      "text_ru": "Если с отрядами всё будет в порядке… встретимся там."
    },
    {
      "ordinal": 62,
      "source_line": 191,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Взрыв! Это взрыв!"
    },
    {
      "ordinal": 63,
      "source_line": 192,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Не паникуйте! Отойдите от светящейся земли! Назад! Подземный оригиний активируется—"
    },
    {
      "ordinal": 64,
      "source_line": 193,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "*сарказское ругательство* Не успеваем—"
    },
    {
      "ordinal": 65,
      "source_line": 196,
      "kind": "narration",
      "text_ru": "Под промёрзшей землёй пробуждается огненное зарево, а в метели вспыхивают искры Катастрофы."
    },
    {
      "ordinal": 66,
      "source_line": 197,
      "kind": "narration",
      "text_ru": "Каждый вдох даётся с невыносимой тяжестью, словно абстрактное понятие «Терра» давит на каждую отдельную жизнь."
    },
    {
      "ordinal": 67,
      "source_line": 217,
      "kind": "narration",
      "text_ru": "И это давление в одно мгновение исчезает без следа."
    },
    {
      "ordinal": 68,
      "source_line": 218,
      "kind": "narration",
      "text_ru": "Но увиденное заставляет невольно глубоко вдохнуть."
    },
    {
      "ordinal": 69,
      "source_line": 221,
      "kind": "multiline",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Ха-а—"
    },
    {
      "ordinal": 70,
      "source_line": 222,
      "kind": "multiline",
      "speaker_cn": "巴别塔成员",
      "source_tag_attributes": {
        "end": true
      },
      "text_ru": "Взрывы… почему они прекратились?"
    },
    {
      "ordinal": 71,
      "source_line": 223,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Снежинки… Они что, застыли прямо в воздухе?"
    },
    {
      "ordinal": 72,
      "source_line": 230,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "Сейчас снежные кристаллы почти неотличимы от кристаллов оригиния. Если быть достаточно внимательным, ими можно управлять."
    },
    {
      "ordinal": 73,
      "source_line": 232,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "В-вы…"
    },
    {
      "ordinal": 74,
      "source_line": 234,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "Точно управлять каждой снежинкой по отдельности крайне сложно. Но в среде с высокой концентрацией оригиния остановить целую метель, напротив, не должно быть трудно."
    },
    {
      "ordinal": 75,
      "source_line": 235,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "Эйдан, ты совсем не слушал на занятиях."
    },
    {
      "ordinal": 76,
      "source_line": 237,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Учи… учитель! Вы пришли! Вы…"
    },
    {
      "ordinal": 77,
      "source_line": 239,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "Я продержусь десять минут."
    },
    {
      "ordinal": 78,
      "source_line": 240,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "Отступайте к лугам внизу долины и идите на юг. Скаут укажет вам путь."
    },
    {
      "ordinal": 79,
      "source_line": 241,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "И ещё: чему я тебя учила? При передвижении в среде с высокой концентрацией оригиния есть множество способов экстренной защиты. А ты не сделал ничего."
    },
    {
      "ordinal": 80,
      "source_line": 243,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Я—"
    },
    {
      "ordinal": 81,
      "source_line": 245,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "Постой… в твоём отряде даже есть люди с острой орипатией! Это никуда не годится!"
    },
    {
      "ordinal": 82,
      "source_line": 246,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "Лови шприц! Я дам вам ещё десять минут на отдых на месте. Я что-нибудь придумаю!"
    },
    {
      "ordinal": 83,
      "source_line": 248,
      "kind": "named",
      "speaker_cn": "巴别塔成员",
      "text_ru": "Учитель, но вы—"
    },
    {
      "ordinal": 84,
      "source_line": 250,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "Шевелитесь, пока Катастрофа не сформировалась окончательно! Пока я ещё могу удерживать её за горло, здесь, по крайней мере, безопасно!"
    },
    {
      "ordinal": 85,
      "source_line": 251,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "—И ещё."
    },
    {
      "ordinal": 86,
      "source_line": 252,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "Я сейчас одновременно использую несколько видов Искусств. К каким школам относится каждое из них — до конца недели хочу увидеть доклады на моём столе. От всех вас."
    },
    {
      "ordinal": 87,
      "source_line": 253,
      "kind": "named",
      "speaker_cn": "Pith",
      "text_ru": "…Так что возвращайтесь живыми, ясно?!"
    },
    {
      "ordinal": 88,
      "source_line": 263,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵A",
      "text_ru": "…Это я. Манфред до сих пор не отдал чётких приказов?"
    },
    {
      "ordinal": 89,
      "source_line": 264,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵A",
      "text_ru": "Что он вообще творит, а?"
    },
    {
      "ordinal": 90,
      "source_line": 265,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵A",
      "text_ru": "Невозможно! Кто-то из высокопоставленных членов Королевского двора? Среди беженцев и войск «Бабеля»? Эй, проверьте!"
    },
    {
      "ordinal": 91,
      "source_line": 267,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵B",
      "text_ru": "Что тут проверять? Чушь какая-то. Наверняка Манфред просто придумал предлог."
    },
    {
      "ordinal": 92,
      "source_line": 268,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵B",
      "text_ru": "Даже если такой человек там есть, он уже считается пленником «Бабеля», верно? Спасать пленных из-под Катастрофы мы не договаривались."
    },
    {
      "ordinal": 93,
      "source_line": 270,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵A",
      "text_ru": "И всё равно придётся выполнять приказ. Проклятье… Эй, пусть отряд «Шипы» проверит наши блокпосты…"
    },
    {
      "ordinal": 94,
      "source_line": 272,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵B",
      "text_ru": "Ладно, ладно… Алло? Говорит восемьдесят шестой, говорит восемьдесят шестой…"
    },
    {
      "ordinal": 95,
      "source_line": 277,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵B",
      "text_ru": "Не отвечают? Куда все делись? Смена караула ещё не наступила."
    },
    {
      "ordinal": 96,
      "source_line": 278,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵B",
      "text_ru": "…Погодите."
    },
    {
      "ordinal": 97,
      "source_line": 279,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵B",
      "text_ru": "Вам не кажется, что стало слишком тихо?"
    },
    {
      "ordinal": 98,
      "source_line": 280,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵B",
      "text_ru": "Ещё недавно кричали пернатые звери…"
    },
    {
      "ordinal": 99,
      "source_line": 282,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵A",
      "text_ru": "Наверное, все звери попрятались от Катастрофы."
    },
    {
      "ordinal": 100,
      "source_line": 283,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵A",
      "text_ru": "По прогнозу, через пять часов Катастрофа полностью накроет это место. Как они смеют отлынивать сейчас?"
    },
    {
      "ordinal": 101,
      "source_line": 284,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵A",
      "text_ru": "Где расписание? Дай сюда."
    },
    {
      "ordinal": 102,
      "source_line": 285,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵A",
      "text_ru": "Я сказал, дай сюда—"
    },
    {
      "ordinal": 103,
      "source_line": 288,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵A",
      "text_ru": "Эй, эй… Где… где все?"
    },
    {
      "ordinal": 104,
      "source_line": 290,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵A",
      "text_ru": "Эй! Говорит восемьдесят шестой отряд! Кто-нибудь слышит? Есть кто живой? Что происходит? Кто-ни—"
    },
    {
      "ordinal": 105,
      "source_line": 292,
      "kind": "named",
      "speaker_cn": "Scout",
      "text_ru": "Есть."
    },
    {
      "ordinal": 106,
      "source_line": 295,
      "kind": "named",
      "speaker_cn": "Scout",
      "text_ru": "—"
    },
    {
      "ordinal": 107,
      "source_line": 303,
      "kind": "named",
      "speaker_cn": "Scout",
      "text_ru": "Фух."
    },
    {
      "ordinal": 108,
      "source_line": 307,
      "kind": "named",
      "speaker_cn": "Scout",
      "text_ru": "Три отряда пока что замолчали. Тревогу не подняли, путь безопасен."
    },
    {
      "ordinal": 109,
      "source_line": 308,
      "kind": "named",
      "speaker_cn": "Scout",
      "text_ru": "Бойцы, двигайтесь по следующим координатам. Медики, выводите раненых по оставленным мной меткам."
    },
    {
      "ordinal": 110,
      "source_line": 309,
      "kind": "named",
      "speaker_cn": "Scout",
      "text_ru": "…Мне нужно ещё кое-что проверить."
    },
    {
      "ordinal": 111,
      "source_line": 314,
      "kind": "named",
      "speaker_cn": "Scout",
      "text_ru": "…"
    },
    {
      "ordinal": 112,
      "source_line": 315,
      "kind": "named",
      "speaker_cn": "Scout",
      "text_ru": "Это действительно частота Военной комиссии. Но они разведчики, а не бесхозные наёмники, напавшие на наши позиции."
    },
    {
      "ordinal": 113,
      "source_line": 316,
      "kind": "named",
      "speaker_cn": "Scout",
      "text_ru": "В задании у них значится «Красная клубника». Они лишь проверяли пути отхода мирных жителей… Ха, Манфред даже солгал им, будто здесь находится «важная особа из Королевского двора»."
    },
    {
      "ordinal": 114,
      "source_line": 317,
      "kind": "named",
      "speaker_cn": "Scout",
      "text_ru": "Хм. Похоже, остальное придётся поручить Аскалон."
    }
  ],
