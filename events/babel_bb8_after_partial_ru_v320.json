  "dialogues": [
    {
      "ordinal": 1,
      "source_line": 12,
      "kind": "narration",
      "text_ru": "Каздель. Где-то в пустоши."
    },
    {
      "ordinal": 2,
      "source_line": 15,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "……"
    },
    {
      "ordinal": 3,
      "source_line": 16,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "…Ха."
    },
    {
      "ordinal": 4,
      "source_line": 17,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Ха-ха! Ха-ха-ха-ха!"
    },
    {
      "ordinal": 5,
      "source_line": 18,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Пророчество? Какое ещё пророчество? Аскалон меня не убила! Не убила!"
    },
    {
      "ordinal": 6,
      "source_line": 19,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Сказанное ещё предстоит истолковать, а истолкованное всё ещё можно изменить. Суть пророческих Искусств — лишь предположения и расчёты. Разве существует судьба, которой нельзя противиться?!"
    },
    {
      "ordinal": 7,
      "source_line": 20,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Королевский двор циклопов — одна большая шутка!"
    },
    {
      "ordinal": 8,
      "source_line": 21,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "…Тьфу. Как же больно."
    },
    {
      "ordinal": 9,
      "source_line": 33,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Я не погиб от руки Аскалон. Не погиб так, как сам себе предсказывал…"
    },
    {
      "ordinal": 10,
      "source_line": 34,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Значит, умереть должна она."
    },
    {
      "ordinal": 11,
      "source_line": 35,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Она непременно придёт убедиться, что я мёртв. Тогда вы пригвоздите её тень и растерзаете её тело."
    },
    {
      "ordinal": 12,
      "source_line": 36,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Она тоже ранена. Я ведь не зря получил свои побои…"
    },
    {
      "ordinal": 13,
      "source_line": 40,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "…Что вы делаете?"
    },
    {
      "ordinal": 14,
      "source_line": 42,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵",
      "text_ru": "……"
    },
    {
      "ordinal": 15,
      "source_line": 44,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "И в такой момент вы направляете оружие на меня?"
    },
    {
      "ordinal": 16,
      "source_line": 45,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Кто вас подкупил?"
    },
    {
      "ordinal": 17,
      "source_line": 47,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵",
      "text_ru": "Никто, босс."
    },
    {
      "ordinal": 18,
      "source_line": 48,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵",
      "text_ru": "Просто отличный шанс воспользоваться случаем и подняться повыше."
    },
    {
      "ordinal": 19,
      "source_line": 50,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Удобный случай? И правда, случай отличный… Бабель вошла в город — можете принести им мою голову, чтобы выслужиться."
    },
    {
      "ordinal": 20,
      "source_line": 51,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "А если Бабель проиграет, вы сможете вернуться на Рынок шрамов и позаботиться о собственном положении."
    },
    {
      "ordinal": 21,
      "source_line": 52,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "……"
    },
    {
      "ordinal": 22,
      "source_line": 54,
      "kind": "named",
      "speaker_cn": "萨卡兹雇佣兵",
      "text_ru": "……"
    },
    {
      "ordinal": 23,
      "source_line": 59,
      "kind": "narration",
      "text_ru": "«Скарай» молча смотрел на наёмников, которых сам же расставил здесь в засаде."
    },
    {
      "ordinal": 24,
      "source_line": 60,
      "kind": "narration",
      "text_ru": "Ветер пронёсся мимо, принося с собой лёгкий запах его крови."
    },
    {
      "ordinal": 25,
      "source_line": 62,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Хех."
    },
    {
      "ordinal": 26,
      "source_line": 63,
      "kind": "named",
      "speaker_cn": "“疤眼”",
      "text_ru": "Хорошо же вы всё рассчитали, старые приятели."
    },
    {
      "ordinal": 27,
      "source_line": 94,
      "kind": "narration",
      "text_ru": "Судьба не убила его. И правда, он смог. Он сумел обратить пророчество вспять."
    },
    {
      "ordinal": 28,
      "source_line": 95,
      "kind": "narration",
      "text_ru": "А затем погиб на сцене, которую сам же построил."
    },
    {
      "ordinal": 29,
      "source_line": 105,
      "kind": "narration",
      "text_ru": "Виктория. Лондиниум."
    },
    {
      "ordinal": 30,
      "source_line": 112,
      "kind": "narration",
      "text_ru": "Огромный дворцовый комплекс в Лондиниуме всегда был слишком тихим."
    },
    {
      "ordinal": 31,
      "source_line": 113,
      "kind": "narration",
      "text_ru": "Терезис презирал равнодушных аристократов, живших в этих дворцах. Он уважал лишь сородичей, которые один за другим пробивались к нему, ставя на кон собственную жизнь."
    },
    {
      "ordinal": 32,
      "source_line": 114,
      "kind": "narration",
      "text_ru": "Даже если клинки, которые они поднимали, были направлены на него самого —"
    },
    {
      "ordinal": 33,
      "source_line": 130,
      "kind": "named",
      "speaker_cn": "特雷西斯",
      "text_ru": "Манфред, если щадить врага, погубишь себя. Не повторяй эту ошибку."
    },
    {
      "ordinal": 34,
      "source_line": 132,
      "kind": "named",
      "speaker_cn": "曼弗雷德",
      "text_ru": "Прости, генерал… Я думал—"
    },
    {
      "ordinal": 35,
      "source_line": 134,
      "kind": "named",
      "speaker_cn": "特雷西斯",
      "text_ru": "Сосредоточься на противнике. Эти предатели, устроившие засаду вокруг нас, должно быть, готовились уже давно."
    },
    {
      "ordinal": 36,
      "source_line": 135,
      "kind": "named",
      "speaker_cn": "特雷西斯",
      "text_ru": "Они всколыхнули сердца викторианцев. Теперь лишь мы сами можем подавить это восстание."
    },
    {
      "ordinal": 37,
      "source_line": 137,
      "kind": "named",
      "speaker_cn": "特雷西斯",
      "text_ru": "*Древний сарказский язык*—"
    },
    {
      "ordinal": 38,
      "source_line": 140,
      "kind": "narration",
      "text_ru": "Едва прозвучал его тихий тайный приказ, как в суматоху уже бесшумно вступили одна за другой несколько фигур."
    },
    {
      "ordinal": 39,
      "source_line": 141,
      "kind": "narration",
      "text_ru": "Словно порыв ветра, разметавший проливной дождь."
    },
    {
      "ordinal": 40,
      "source_line": 144,
      "kind": "named",
      "speaker_cn": "弃名死士",
      "text_ru": "Отступи."
    }
  ],
