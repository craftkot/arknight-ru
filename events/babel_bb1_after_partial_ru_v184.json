  "opening_text": [
    {
      "source_line": 11,
      "text_ru": "Осень 1031 года"
    },
    {
      "source_line": 12,
      "text_ru": "Каздельский регион, мобильный город Каздель"
    }
  ],
  "progress": {
    "translated_dialogue_and_narration": 40,
