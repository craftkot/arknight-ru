  "dialogues": [
    {
      "ordinal": 1,
      "source_line": 28,
      "kind": "named",
      "speaker_cn": "好运",
      "speaker_ru": "Везунчик",
      "text_ru": "Пропустите, пропустите… Дайте пройти!"
    },
    {
      "ordinal": 2,
      "source_line": 43,
      "kind": "named",
      "speaker_cn": "不耐烦的平民",
      "speaker_ru": "Раздражённый горожанин",
      "text_ru": "Не толкайся! Хочешь место получше? Меняю своё на кусок высокочистого ориджиния из шахт."
    },
    {
      "ordinal": 3,
      "source_line": 51,
      "kind": "named",
      "speaker_cn": "不耐烦的平民",
      "speaker_ru": "Раздражённый горожанин",
      "text_ru": "Эй, ты ещё и листовку у меня выхватил! Уф, от тебя кровью за версту несёт…"
    },
    {
      "ordinal": 4,
      "source_line": 53,
      "kind": "named",
      "speaker_cn": "好运",
      "speaker_ru": "Везунчик",
      "text_ru": "Когда обыскиваешь дома мертвецов, без этого не обойтись. Лин… го… нес. Так ведь называется место на этой листовке?"
    },
    {
      "ordinal": 5,
      "source_line": 54,
      "kind": "named",
      "speaker_cn": "好运",
      "speaker_ru": "Везунчик",
      "text_ru": "А что такое Лингонес?"
    },
    {
      "ordinal": 6,
      "source_line": 56,
      "kind": "named",
      "speaker_cn": "不耐烦的平民",
      "speaker_ru": "Раздражённый горожанин",
      "text_ru": "Галлия."
    },
    {
      "ordinal": 7,
      "source_line": 58,
      "kind": "named",
      "speaker_cn": "好运",
      "speaker_ru": "Везунчик",
      "text_ru": "А-а. А где находится Галлия?"
    },
    {
      "ordinal": 8,
      "source_line": 60,
      "kind": "named",
      "speaker_cn": "不耐烦的平民",
      "speaker_ru": "Раздражённый горожанин",
      "text_ru": "Откуда мне, *сарказское ругательство*, знать, где эта Галлия?!"
    },
    {
      "ordinal": 9,
      "source_line": 62,
      "kind": "named",
      "speaker_cn": "好运",
      "speaker_ru": "Везунчик",
      "text_ru": "Цыц, чего разорался?"
    },
    {
      "ordinal": 10,
      "source_line": 64,
      "kind": "named",
      "speaker_cn": "不耐烦的平民",
      "speaker_ru": "Раздражённый горожанин",
      "text_ru": "Тише ты! Обе Их Высочества и важные особы королевских дворов сейчас совещаются в зале. Говорят, собираются навести порядок в городе. Не заметил, что в последние дни на улицах стало больше стражи?"
    },
    {
      "ordinal": 11,
      "source_line": 65,
      "kind": "named",
      "speaker_cn": "不耐烦的平民",
      "speaker_ru": "Раздражённый горожанин",
      "text_ru": "Так что поосторожнее!"
    },
    {
      "ordinal": 12,
      "source_line": 67,
      "kind": "named",
      "speaker_cn": "好运",
      "speaker_ru": "Везунчик",
      "text_ru": "Эх… Душно сегодня."
    },
    {
      "ordinal": 13,
      "source_line": 80,
      "kind": "named",
      "speaker_cn": "特雷西斯",
      "speaker_ru": "Терезис",
      "text_ru": "Всё сказано."
    },
    {
      "ordinal": 14,
      "source_line": 81,
      "kind": "named",
      "speaker_cn": "特雷西斯",
      "speaker_ru": "Терезис",
      "text_ru": "Военная комиссия сменит Военный совет и будет помогать королю сарказов Терезии принимать решения по военным и государственным делам Казделя."
    },
    {
      "ordinal": 15,
      "source_line": 82,
      "kind": "named",
      "speaker_cn": "特雷西斯",
      "speaker_ru": "Терезис",
      "text_ru": "Отныне единственным официальным органом управления Казделем станет Военная комиссия. Никто больше не вправе отдавать сарказам приказы от имени королевских дворов."
    },
    {
      "ordinal": 16,
      "source_line": 83,
      "kind": "named",
      "speaker_cn": "特雷西斯",
      "speaker_ru": "Терезис",
      "text_ru": "Все вы заранее получили текст постановления. Итак, владыки королевских дворов, всё ещё привязанные к названию «Военный совет»…"
    },
    {
      "ordinal": 17,
      "source_line": 84,
      "kind": "named",
      "speaker_cn": "特雷西斯",
      "speaker_ru": "Терезис",
      "text_ru": "Отныне Военная комиссия Казделя станет последним и вечным оплотом сарказов и принесёт нашему народу новый порядок."
    },
    {
      "ordinal": 18,
      "source_line": 86,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "speaker_ru": "Терезия",
      "text_ru": "Есть ещё вопросы?"
    },
    {
      "ordinal": 19,
      "source_line": 91,
      "kind": "named",
      "speaker_cn": "女妖",
      "speaker_ru": "Банши",
      "text_ru": "Ваше Высочество… Сегодня вы выглядите ещё более измученной, чем вчера."
    },
    {
      "ordinal": 20,
      "source_line": 92,
      "kind": "named",
      "speaker_cn": "女妖",
      "speaker_ru": "Банши",
      "text_ru": "Берегите себя. Сколько бы военных комиссий у нас ни было…"
    },
    {
      "ordinal": 21,
      "source_line": 93,
      "kind": "named",
      "speaker_cn": "女妖",
      "speaker_ru": "Банши",
      "text_ru": "…мы не можем позволить себе потерять и вас, Ваше Высочество Терезия."
    },
    {
      "ordinal": 22,
      "source_line": 95,
      "kind": "named",
      "speaker_cn": "特雷西斯",
      "speaker_ru": "Терезис",
      "text_ru": "…"
    },
    {
      "ordinal": 23,
      "source_line": 97,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "speaker_ru": "Терезия",
      "text_ru": "Лакерамалина… спасибо."
    },
    {
      "ordinal": 24,
      "source_line": 99,
      "kind": "named",
      "speaker_cn": "菈玛莲",
      "speaker_ru": "Лакерамалина",
      "text_ru": "Я знаю, сколько сил вы отдали ради этого дня… И знаю, как нынешний Каздель относится к банши, укрывшимся в речной долине."
    },
    {
      "ordinal": 25,
      "source_line": 101,
      "kind": "named",
      "speaker_cn": "特雷西斯",
      "speaker_ru": "Терезис",
      "text_ru": "…"
    },
    {
      "ordinal": 26,
      "source_line": 103,
      "kind": "named",
      "speaker_cn": "菈玛莲",
      "speaker_ru": "Лакерамалина",
      "text_ru": "Но прежде чем мы объявим о своей позиции… По дороге сюда я встретила заблудившегося посланника личей. Он попросил передать вам письмо."
    },
    {
      "ordinal": 27,
      "source_line": 104,
      "kind": "named",
      "speaker_cn": "菈玛莲",
      "speaker_ru": "Лакерамалина",
      "text_ru": "Это лишний раз показывает, как сильно изменился Каздель: посланник даже не сумел найти сюда дорогу."
    },
    {
      "ordinal": 28,
      "source_line": 106,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "speaker_ru": "Терезия",
      "text_ru": "Хм… Письмо, доставленное из Лейтании."
    },
    {
      "ordinal": 29,
      "source_line": 108,
      "kind": "named",
      "speaker_cn": "菈玛莲",
      "speaker_ru": "Лакерамалина",
      "text_ru": "Если всё идёт так, как я предполагаю, ваш гонец до сих пор не получил никаких известий от циклопов."
    },
    {
      "ordinal": 30,
      "source_line": 109,
      "kind": "named",
      "speaker_cn": "菈玛莲",
      "speaker_ru": "Лакерамалина",
      "text_ru": "Так что вместо голосов, затерянных глубоко в снегах и метелях, давайте послушаем ответ лейтанийских личей."
    },
    {
      "ordinal": 31,
      "source_line": 111,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "speaker_ru": "Терезия",
      "text_ru": "Ты права. Сарказы… уже очень давно не были по-настоящему едины."
    },
    {
      "ordinal": 32,
      "source_line": 116,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "speaker_ru": "Терезия",
      "text_ru": "Хм…?"
    },
    {
      "ordinal": 33,
      "source_line": 118,
      "kind": "plain",
      "text_ru": "Изящные письмена на листе превращаются в тонкие нити, сплетаются над бумагой и наконец принимают очертания знакомой фигуры."
    },
    {
      "ordinal": 34,
      "source_line": 124,
      "kind": "named",
      "speaker_cn": "菈玛莲",
      "speaker_ru": "Лакерамалина",
      "text_ru": "Фремонт, лич, давно живущий в Лейтании. Похоже, теперь именно он занимает пост «Переписчика»."
    },
    {
      "ordinal": 35,
      "source_line": 125,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "speaker_ru": "Терезия",
      "text_ru": "Похоже, стиль Искусств лейтанийских личей несколько изменился. Хм, он выглядит очень взволнованным."
    },
    {
      "ordinal": 36,
      "source_line": 126,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "speaker_ru": "Терезия",
      "text_ru": "…"
    },
    {
      "ordinal": 37,
      "source_line": 127,
      "kind": "named",
      "speaker_cn": "特蕾西娅",
      "speaker_ru": "Терезия",
      "text_ru": "…Но почему изображение есть, а звука совсем нет?"
    },
    {
      "ordinal": 38,
      "source_line": 128,
      "kind": "named",
      "speaker_cn": "菈玛莲",
      "speaker_ru": "Лакерамалина",
      "text_ru": "…Хе-хе."
    },
    {
      "ordinal": 39,
      "source_line": 129,
      "kind": "named",
      "speaker_cn": "菈玛莲",
      "speaker_ru": "Лакерамалина",
      "text_ru": "Посланник личей намекнул, что ему было крайне трудно подобрать приличные слова вместо выражений своего учителя… Но я не думала, что он просто уберёт звук."
    },
    {
      "ordinal": 40,
      "source_line": 130,
      "kind": "named",
      "speaker_cn": "菈玛莲",
      "speaker_ru": "Лакерамалина",
      "text_ru": "Словом, Фремонт приносит извинения от имени личей. Они по-прежнему настолько увлечены поиском знаний, что не могут отвлечься ради долгой поездки на собрание."
    }
  ]
}
